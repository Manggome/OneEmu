<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 and above. Same rule for both cloud backup and a direct device-to-device transfer:
  keep the settings and the library, leave behind what the app can simply download again.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="cores/" />
        <exclude domain="file" path="native_crash.txt" />
        <exclude domain="file" path="native_crash.prev.txt" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="cores/" />
    </device-transfer>
</data-extraction-rules>
