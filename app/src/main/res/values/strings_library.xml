    <string name="lib_arcade_file_missing">없음</string>
    <string name="lib_arcade_file_found">CRC %1$s</string>
    <string name="lib_arcade_samples_title">샘플</string>
    <string name="lib_arcade_samples_path">%1$s 파일을 아래 폴더에 넣어 주세요. 샘플은 공식 배포처가 없어 앱에서 자동으로 내려받지 않습니다.</string>
