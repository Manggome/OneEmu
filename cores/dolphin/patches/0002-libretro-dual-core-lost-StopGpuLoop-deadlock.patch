diff --git a/Source/Core/DolphinLibretro/Main.cpp b/Source/Core/DolphinLibretro/Main.cpp
index cd8753b..d34c18f 100644
--- a/Source/Core/DolphinLibretro/Main.cpp
+++ b/Source/Core/DolphinLibretro/Main.cpp
@@ -484,6 +484,10 @@ void retro_run(void)
 
   if (system.IsDualCoreMode())
   {
+    // Arm the GPU loop first so the CPU thread's StopGpuLoop() at the next field boundary is
+    // honoured even when it fires before RunGpuLoop() is entered (otherwise: deadlock, both
+    // threads waiting on each other).
+    system.GetFifo().PrepareGpuLoop();
     Core::DoFrameStep(system);
     system.GetFifo().RunGpuLoop();
   }
diff --git a/Source/Core/VideoCommon/Fifo.cpp b/Source/Core/VideoCommon/Fifo.cpp
index d40bd0e..7e95980 100644
--- a/Source/Core/VideoCommon/Fifo.cpp
+++ b/Source/Core/VideoCommon/Fifo.cpp
@@ -140,6 +140,15 @@ void FifoManager::StopGpuLoop()
 {
   m_gpu_mainloop.Stop(Common::BlockingLoop::StopMode::NonBlock);
 }
+
+// Must be called on the libretro thread before the CPU thread is released for the next frame.
+// Stop() is a no-op while the loop is in its stopped state (the previous RunGpuLoop() exit), so a
+// StopGpuLoop() issued by the CPU thread before RunGpuLoop() re-armed the loop was lost and
+// RunGpuLoop() then waited forever for a shutdown that had already been requested.
+void FifoManager::PrepareGpuLoop()
+{
+  m_gpu_mainloop.Prepare();
+}
 #endif
 
