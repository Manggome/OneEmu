index f47c1798..0efc32fc 100644
--- a/wie-core-arm/cpp/dynarmic_shim.cpp
+++ b/wie-core-arm/cpp/dynarmic_shim.cpp
@@ -10,6 +10,14 @@
 #include <memory>
 #include <optional>
 
+#if defined(_WIN32)
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#include <windows.h>
+#else
+#include <sys/mman.h>
+#endif
+
 #include <dynarmic/interface/A32/a32.h>
 #include <dynarmic/interface/A32/config.h>
 #include <dynarmic/interface/A32/coprocessor.h>
@@ -282,4 +290,24 @@ void wie_dyn_invalidate(void* handle, std::uint32_t address, std::uint32_t lengt
     static_cast<Shim*>(handle)->jit->InvalidateCacheRange(address, length);
 }
 
+// Zero-filled guest memory straight from the OS: pages are committed when first touched. A calloc of the
+// 256 MiB heap is committed (and zeroed) up front by Android's allocator, ~270 MB per game.
+void* wie_dyn_map_pages(std::size_t size) {
+#if defined(_WIN32)
+    return VirtualAlloc(nullptr, size, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);
+#else
+    void* p = mmap(nullptr, size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    return p == MAP_FAILED ? nullptr : p;
+#endif
+}
+
+void wie_dyn_unmap_pages(void* pages, std::size_t size) {
+#if defined(_WIN32)
+    (void)size;
+    VirtualFree(pages, 0, MEM_RELEASE);
+#else
+    munmap(pages, size);
+#endif
+}
+
 }  // extern "C"
