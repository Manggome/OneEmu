+type BlitArea = (i32, i32, u32, u32, i32, i32, Clip);
+
+fn copy<T: PixelType>(context: &mut dyn WIPICContext, destination: &FrameBuffer, source: &FrameBuffer, area: BlitArea) -> Result<()> {
+    let Some((x, y, source_x, source_y, columns, rows)) = blit_bounds(destination, source, area) else {
+        return Ok(());
+    };
+    let pixels = read_rows::<T>(context, source, source_x, source_y, columns, rows)?;
+    write_rows::<T>(context, destination, x, y, columns, &pixels)
+}
+
+/// Destination and source positions and the size of the part of `area` that lands in both framebuffers and
+/// the clip, or `None` when nothing does.
+fn blit_bounds(
+    destination: &FrameBuffer,
+    source: &FrameBuffer,
+    (x, y, width, height, source_x, source_y, clip): BlitArea,
+) -> Option<(i64, i64, i64, i64, usize, usize)> {
+    let (x, y, source_x, source_y) = (x as i64, y as i64, source_x as i64, source_y as i64);
+    // the offsets inside the drawn area that land in the destination, the source and the clip
+    let x_start = 0i64.max(-x).max(-source_x).max(clip.x as i64 - x);
+    let x_end = (width as i64)
+        .min(destination.0.width as i64 - x)
+        .min(source.0.width as i64 - source_x)
+        .min(clip.x as i64 + clip.width as i64 - x);
+    let y_start = 0i64.max(-y).max(-source_y).max(clip.y as i64 - y);
+    let y_end = (height as i64)
+        .min(destination.0.height as i64 - y)
+        .min(source.0.height as i64 - source_y)
+        .min(clip.y as i64 + clip.height as i64 - y);
+    if x_start >= x_end || y_start >= y_end {
+        return None;
+    }
+
+    Some((
+        x + x_start,
+        y + y_start,
+        source_x + x_start,
+        source_y + y_start,
+        (x_end - x_start) as usize,
+        (y_end - y_start) as usize,
+    ))
+}
+
+/// `OPAQUE_DESTINATION`: `D` has no alpha and converts losslessly (a fully transparent source pixel then
+/// leaves the destination pixel as it is).
+fn blit<S: PixelType, D: PixelType, const OPAQUE_DESTINATION: bool>(
+    context: &mut dyn WIPICContext,
+    destination: &FrameBuffer,
+    source: &FrameBuffer,
+    area: BlitArea,
+) -> Result<()> {
+    let Some((x, y, source_x, source_y, columns, rows)) = blit_bounds(destination, source, area) else {
+        return Ok(());
+    };
+
+    // all source rows are read before the destination is written, so drawing a framebuffer onto itself
+    // sees a snapshot like the canvas path did
+    let source_pixels = read_rows::<S>(context, source, source_x, source_y, columns, rows)?;
+    let mut pixels = read_rows::<D>(context, destination, x, y, columns, rows)?;
+    for (pixel, &source_pixel) in pixels.iter_mut().zip(source_pixels.iter()) {
+        let color = S::to_color(source_pixel);
+        *pixel = match color.a {
+            255 => D::from_color(color),
+            0 if OPAQUE_DESTINATION => continue,
+            // fully transparent: the destination color, made opaque (what blending with factor 0 gives)
+            0 => D::from_color(Color {
+                a: 0xff,
+                ..D::to_color(*pixel)
+            }),
+            _ => D::from_color(blend(color, D::to_color(*pixel))),
+        };
+    }
+    write_rows::<D>(context, destination, x, y, columns, &pixels)
+}
+
+/// `color` over `background`, the formula of `ImageBufferCanvas`'s blended pixel writes.
+fn blend(color: Color, background: Color) -> Color {
+    let factor = color.a as f32 / 255.0;
+
+    Color {
+        a: 0xff,
+        r: (color.r as f32 * factor + background.r as f32 * (1.0 - factor)) as u8,
+        g: (color.g as f32 * factor + background.g as f32 * (1.0 - factor)) as u8,
+        b: (color.b as f32 * factor + background.b as f32 * (1.0 - factor)) as u8,
+    }
+}
+
+fn pixel_offset(framebuffer: &FrameBuffer, x: i64, y: i64) -> u32 {
+    // rows are `width` pixels apart, like FrameBuffer::image reads them
+    ((y * framebuffer.0.width as i64 + x) * (framebuffer.0.bpp / 8) as i64) as u32
+}
+
+fn read_rows<T: PixelType>(
+    context: &dyn WIPICContext,
+    framebuffer: &FrameBuffer,
+    x: i64,
+    y: i64,
+    columns: usize,
+    rows: usize,
+) -> Result<Vec<T::DataType>> {
+    let base = context.data_ptr(framebuffer.0.buf)?;
+    let mut pixels = vec![T::DataType::zeroed(); columns * rows];
+    for (row, line) in pixels.chunks_mut(columns).enumerate() {
+        context.read_bytes(base + pixel_offset(framebuffer, x, y + row as i64), cast_slice_mut(line))?;
+    }
+
+    Ok(pixels)
+}
+
+fn write_rows<T: PixelType>(
+    context: &mut dyn WIPICContext,
+    framebuffer: &FrameBuffer,
+    x: i64,
+    y: i64,
+    columns: usize,
+    pixels: &[T::DataType],
+) -> Result<()> {
+    let base = context.data_ptr(framebuffer.0.buf)?;
+    for (row, line) in pixels.chunks(columns).enumerate() {
+        context.write_bytes(base + pixel_offset(framebuffer, x, y + row as i64), cast_slice(line))?;
+    }
+
+    Ok(())
 }
 
