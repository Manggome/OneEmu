+        // RGB565 has no alpha and converts to a color and back losslessly: a plain copy
+        (16, 16) => copy::<Rgb565Pixel>(context, framebuffer, source, area),
+        (16, 32) => blit::<Rgb565Pixel, ArgbPixel, false>(context, framebuffer, source, area),
+        (32, 16) => blit::<ArgbPixel, Rgb565Pixel, true>(context, framebuffer, source, area),
+        (32, 32) => blit::<ArgbPixel, ArgbPixel, false>(context, framebuffer, source, area),
+        _ => {
+            let image = source.image(context)?;
+            draw_image(context, framebuffer, x, y, width, height, &*image, source_x, source_y, clip)
+        }
+    }
