+/// Fills the even-odd interior of the polygon together with its outline.
+pub fn fill_polygon(context: &mut dyn WIPICContext, framebuffer: &FrameBuffer, points: &[(i32, i32)], color: Color, clip: Clip) -> Result<()> {
+    let (Some(min_y), Some(max_y)) = (points.iter().map(|p| p.1).min(), points.iter().map(|p| p.1).max()) else {
+        return Ok(());
+    };
+    let first = min_y.max(clip.y).max(0);
+    let last = max_y
+        .min(clip.y.saturating_add(clip.height as i32) - 1)
+        .min(framebuffer.0.height as i32 - 1);
+
+    write_canvas(context, framebuffer, |canvas| {
+        let mut crossings = vec![];
+        for y in first..=last {
+            crossings.clear();
+            for (index, &(x1, y1)) in points.iter().enumerate() {
+                let (x2, y2) = points[(index + 1) % points.len()];
+                if y1 == y2 || y < y1.min(y2) || y >= y1.max(y2) {
+                    continue;
+                }
+                let x = x1 as i64 + (y as i64 - y1 as i64) * (x2 as i64 - x1 as i64) / (y2 as i64 - y1 as i64);
+                crossings.push(x.clamp(i32::MIN as i64, i32::MAX as i64) as i32);
+            }
+            crossings.sort_unstable();
+            for span in crossings.as_chunks::<2>().0 {
+                canvas.fill_rect(span[0], y, span[1].abs_diff(span[0]) + 1, 1, color, clip);
+            }
+        }
+        stroke_polygon(canvas, points, color, clip);
+    })
+}
+
+fn stroke_polygon(canvas: &mut dyn Canvas, points: &[(i32, i32)], color: Color, clip: Clip) {
+    for (index, &(x1, y1)) in points.iter().enumerate() {
+        let (x2, y2) = points[(index + 1) % points.len()];
+        canvas.draw_line(x1, y1, x2, y2, color, clip);
+    }
+}
