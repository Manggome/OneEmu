+/// Size of the file entry `name` in a zip archive, or `None` when it has no such file.
+pub fn zip_entry_size(zip: &[u8], name: &str) -> Result<Option<u64>> {
+    extern crate std; // XXX
+
+    use std::io::Cursor;
+    use zip::ZipArchive;
+
+    let mut archive = ZipArchive::new(Cursor::new(zip)).map_err(|x| WieError::FatalError(format!("Invalid zip archive: {x}")))?;
+    Ok(archive.by_name(name).ok().filter(|file| file.is_file()).map(|file| file.size()))
+}
+
+/// Contents of the file entry `name` in a zip archive, or `None` when it has no such file.
+pub fn read_zip_entry(zip: &[u8], name: &str) -> Result<Option<Vec<u8>>> {
+    extern crate std; // XXX
+
+    use std::io::{Cursor, Read};
+    use zip::ZipArchive;
+
+    let mut archive = ZipArchive::new(Cursor::new(zip)).map_err(|x| WieError::FatalError(format!("Invalid zip archive: {x}")))?;
+    let Ok(mut file) = archive.by_name(name) else {
+        return Ok(None);
+    };
+    if !file.is_file() {
+        return Ok(None);
+    }
+    let mut data = Vec::new();
+    file.read_to_end(&mut data)
+        .map_err(|x| WieError::FatalError(format!("Failed to read zip entry {name}: {x}")))?;
+
+    Ok(Some(data))
+}
