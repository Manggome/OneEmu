+/// MC_grpDrawImage per frame (메이플스토리 도적편), which made that copying the biggest cost of a frame.
+pub fn draw_framebuffer(
+    context: &mut dyn WIPICContext,
+    framebuffer: &FrameBuffer,
+    x: i32,
+    y: i32,
+    width: u32,
+    height: u32,
+    source: &FrameBuffer,
+    source_x: i32,
+    source_y: i32,
+    clip: Clip,
