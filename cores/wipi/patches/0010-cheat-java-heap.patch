diff --git a/wie-ktf/src/runtime/java/jvm_support/heap.rs b/wie-ktf/src/runtime/java/jvm_support/heap.rs
new file mode 100644
index 00000000..4af0ff88
--- /dev/null
+++ b/wie-ktf/src/runtime/java/jvm_support/heap.rs
@@ -0,0 +1,177 @@
+//! [`JavaHeap`] for KTF: classes, objects and static fields all live in guest memory.
+
+use alloc::{
+    string::{String, ToString},
+    vec::Vec,
+};
+
+use jvm::{Field, JavaType, Jvm};
+use jvm_types::FieldAccessFlags;
+use wipi_types::ktf::java::{JavaClass as RawJavaClass, JavaClassDescriptor as RawJavaClassDescriptor, JavaClassInstance as RawJavaClassInstance};
+
+use wie_backend::{JavaArray, JavaHeap, JavaSlot};
+use wie_core_arm::ArmCore;
+use wie_jvm_support::native::array_element_size;
+use wie_util::{ByteRead, read_generic};
+
+use super::{class_definition::JavaClassDefinition, field::JavaField};
+
+/// What host tools need to find Java values again: the JVM and the application's native class records.
+/// Kept as a core extension, so [`ArmCore::shutdown`] drops it with the rest of the emulator.
+#[derive(Default)]
+pub struct KtfJavaState {
+    pub jvm: Option<Jvm>,
+    pub classes: Vec<u32>,
+}
+
+pub struct KtfJavaHeap {
+    core: ArmCore,
+    jvm: Jvm,
+    classes: Vec<u32>,
+}
+
+impl KtfJavaHeap {
+    pub fn new(core: &ArmCore) -> Option<Self> {
+        let (jvm, classes) = core.with_extension(|state: &mut KtfJavaState| (state.jvm.clone(), state.classes.clone()));
+
+        Some(Self {
+            core: core.clone(),
+            jvm: jvm?,
+            classes,
+        })
+    }
+
+    fn class(&self, name: &str) -> Option<JavaClassDefinition> {
+        if let Some(class) = self.jvm.get_class(name)
+            && let Some(definition) = class.definition.as_any().downcast_ref::<JavaClassDefinition>()
+        {
+            return Some(definition.clone());
+        }
+        self.classes
+            .iter()
+            .find(|&&ptr| self.class_name(ptr).as_deref() == Some(name))
+            .map(|&ptr| JavaClassDefinition::from_raw(ptr, &self.core))
+    }
+
+    /// Name of the class record at `ptr_class`, read defensively: the pointer may come from a stale field.
+    fn class_name(&self, ptr_class: u32) -> Option<String> {
+        let raw: RawJavaClass = read_generic(&self.core, ptr_class).ok()?;
+        let descriptor: RawJavaClassDescriptor = read_generic(&self.core, raw.ptr_descriptor).ok()?;
+        bounded_name(&self.core, descriptor.ptr_name)
+    }
+
+    /// The class of a live object at `object`, or None.
+    fn object_class(&self, object: u32) -> Option<(JavaClassDefinition, String, u32)> {
+        if object == 0 {
+            return None;
+        }
+        let raw: RawJavaClassInstance = read_generic(&self.core, object).ok()?;
+        let name = self.class_name(raw.ptr_class)?;
+        // Array classes can be compiled into the application; other classes must be the ones the JVM knows.
+        let known = name.starts_with('[')
+            || self
+                .jvm
+                .get_class(&name)
+                .and_then(|class| class.definition.as_any().downcast_ref::<JavaClassDefinition>().map(|x| x.ptr_raw))
+                == Some(raw.ptr_class)
+            || self.classes.contains(&raw.ptr_class);
+        let mut probe = [0u8; 4];
+        (known && self.core.read_bytes(raw.ptr_fields, &mut probe).is_ok())
+            .then(|| (JavaClassDefinition::from_raw(raw.ptr_class, &self.core), name, raw.ptr_fields))
+    }
+}
+
+/// A class name of printable ASCII, or None when `ptr` doesn't hold one.
+fn bounded_name(core: &ArmCore, ptr: u32) -> Option<String> {
+    let mut name = String::new();
+    let mut buffer = [0u8; 1];
+    for offset in 0..256 {
+        core.read_bytes(ptr.checked_add(offset)?, &mut buffer).ok()?;
+        match buffer[0] {
+            0 => return (!name.is_empty()).then_some(name),
+            c @ 0x21..=0x7e => name.push(c as char),
+            _ => return None,
+        }
+    }
+    None
+}
+
+fn slot(field: &JavaField, address: u32) -> Option<JavaSlot> {
+    let name = field.name().ok()?;
+    let descriptor = name.descriptor().to_string();
+    let size = if matches!(descriptor.as_str(), "J" | "D") { 8 } else { 4 };
+
+    Some(JavaSlot {
+        name: name.name().to_string(),
+        descriptor,
+        address,
+        size,
+    })
+}
+
+impl JavaHeap for KtfJavaHeap {
+    fn class_names(&self) -> Vec<String> {
+        let platform = wie_wipi_java::get_protos()
+            .into_iter()
+            .map(|x| x.name)
+            .chain(wie_midp::get_protos().into_iter().map(|x| x.name));
+        let platform = platform.filter(|name| self.jvm.has_class(name)).map(String::from);
+        self.classes.iter().filter_map(|&ptr| self.class_name(ptr)).chain(platform).collect()
+    }
+
+    fn static_fields(&self, class: &str) -> Vec<JavaSlot> {
+        let Some(class) = self.class(class) else {
+            return Vec::new();
+        };
+        let Ok(fields) = class.fields() else {
+            return Vec::new();
+        };
+        fields
+            .filter(|field| Field::access_flags(field).contains(FieldAccessFlags::STATIC))
+            // KTF keeps a static value in the field record's last word, whatever its type.
+            .filter_map(|field| slot(&field, field.static_address().ok()?).map(|x| JavaSlot { size: 4, ..x }))
+            .collect()
+    }
+
+    fn object(&self, object: u32) -> Option<(String, Vec<JavaSlot>)> {
+        let (class, name, ptr_fields) = self.object_class(object)?;
+        if name.starts_with('[') {
+            return Some((name, Vec::new()));
+        }
+        let mut chain = Vec::new();
+        let mut current = Some(class);
+        while let Some(class) = current {
+            current = class.parent_class().ok()?;
+            chain.push(class);
+            if chain.len() > 64 {
+                return None;
+            }
+        }
+        let mut slots = Vec::new();
+        for class in chain.iter().rev() {
+            for field in class.fields().ok()? {
+                if Field::access_flags(&field).contains(FieldAccessFlags::STATIC) {
+                    continue;
+                }
+                // Instance fields start after the vtable-index word.
+                let offset = field.offset().ok()?;
+                slots.extend(slot(&field, ptr_fields + 4 + offset));
+            }
+        }
+        Some((name, slots))
+    }
+
+    fn array(&self, object: u32) -> Option<JavaArray> {
+        let (_, name, ptr_fields) = self.object_class(object)?;
+        let element = name.strip_prefix('[')?.to_string();
+        let length: u32 = read_generic(&self.core, ptr_fields + 4).ok()?;
+        let element_size = array_element_size(&JavaType::try_parse(&element)?) as u32;
+
+        Some(JavaArray {
+            element,
+            length,
+            address: ptr_fields + 8,
+            element_size,
+        })
+    }
+}
