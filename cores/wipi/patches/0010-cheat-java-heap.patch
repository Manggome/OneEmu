+/// Name-based access to a guest JVM whose classes and objects live in guest memory (KTF / LGT). Everything
+/// resolves to guest addresses, read and written through [`GuestMemory`]; object references are guest pointers.
+pub trait JavaHeap {
+    /// Classes to start a search from: the application's own classes and the loaded platform classes.
+    fn class_names(&self) -> Vec<String>;
+    /// Static fields declared by `class` (internal name, `pkg/Name`). Empty when the class is not loaded.
+    fn static_fields(&self, class: &str) -> Vec<JavaSlot>;
+    /// Class name and instance fields (inherited ones first) of the object at `object`; None when `object` is
+    /// not a live object.
+    fn object(&self, object: u32) -> Option<(String, Vec<JavaSlot>)>;
+    /// The elements of the array object at `object`; None when it is not an array.
+    fn array(&self, object: u32) -> Option<JavaArray>;
+
+    fn static_field(&self, class: &str, name: &str) -> Option<JavaSlot> {
+        self.static_fields(class).into_iter().find(|x| x.name == name)
+    }
+
+    /// Field `name` of `object`; a field declared by a subclass hides one of the same name in its superclass.
+    fn instance_field(&self, object: u32, name: &str) -> Option<JavaSlot> {
+        self.object(object)?.1.into_iter().rev().find(|x| x.name == name)
+    }
 }
 
