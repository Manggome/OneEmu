diff --git a/wie-lgt/src/runtime/java/jvm_support/heap.rs b/wie-lgt/src/runtime/java/jvm_support/heap.rs
new file mode 100644
index 00000000..b67fb984
--- /dev/null
+++ b/wie-lgt/src/runtime/java/jvm_support/heap.rs
@@ -0,0 +1,216 @@
+//! [`JavaHeap`] for LGT AOT Java: generated class records, objects and static storage live in guest memory.
+
+use alloc::{
+    format,
+    string::{String, ToString},
+    vec::Vec,
+};
+use core::mem::size_of;
+
+use jvm::{ClassDefinition, Field, JavaType, Jvm};
+use jvm_types::FieldAccessFlags;
+use wipi_types::lgt::java::{LGT_JAVA_CLASS_SUPER_CLASS_IS_NAME, LgtJavaClass as RawJavaClass, LgtJavaClassDescriptor as RawJavaClassDescriptor};
+
+use wie_backend::{JavaArray, JavaHeap, JavaSlot};
+use wie_core_arm::ArmCore;
+use wie_jvm_support::native::array_element_size;
+use wie_util::read_generic;
+
+use super::{JavaClassDefinition, JavaClassInstance, LgtJvmWord, names::guest_name};
+
+/// Link state of a generated class whose runtime class (and static storage) exists.
+const LINKED: u16 = 3;
+
+/// What host tools need to find Java values again: the JVM and the application's generated class table.
+/// Kept as a core extension, so [`ArmCore::shutdown`] drops it with the rest of the emulator.
+#[derive(Default)]
+pub struct LgtJavaState {
+    pub jvm: Option<Jvm>,
+    pub generated_classes: u32,
+}
+
+pub struct LgtJavaHeap {
+    core: ArmCore,
+    jvm: Jvm,
+    generated_classes: u32,
+}
+
+impl LgtJavaHeap {
+    pub fn new(core: &ArmCore) -> Option<Self> {
+        let (jvm, generated_classes) = core.with_extension(|state: &mut LgtJavaState| (state.jvm.clone(), state.generated_classes));
+
+        Some(Self {
+            core: core.clone(),
+            jvm: jvm?,
+            generated_classes,
+        })
+    }
+
+    fn class(&self, name: &str) -> Option<JavaClassDefinition> {
+        let class = self.jvm.get_class(name)?;
+        class.definition.as_any().downcast_ref::<JavaClassDefinition>().cloned()
+    }
+
+    fn super_class(&self, class: &JavaClassDefinition) -> Option<JavaClassDefinition> {
+        let descriptor = class.descriptor().ok()?;
+        if descriptor.ptr_super_class == 0 {
+            None
+        } else if descriptor.flags & LGT_JAVA_CLASS_SUPER_CLASS_IS_NAME != 0 {
+            self.class(&guest_name(&self.core, descriptor.ptr_super_class).ok()?)
+        } else {
+            Some(JavaClassDefinition::from_raw(descriptor.ptr_super_class, &self.core))
+        }
+    }
+
+    /// Generated class records in bucket order (see `LgtClassLoader`).
+    fn generated(&self) -> Vec<RawJavaClassDescriptor> {
+        let mut classes = Vec::new();
+        if self.generated_classes == 0 {
+            return classes;
+        }
+        let Ok(last_bucket) = read_generic::<u32, _>(&self.core, self.generated_classes) else {
+            return classes;
+        };
+        for bucket in 0..=last_bucket.min(0x10000) {
+            let mut ptr_class: u32 = read_generic(&self.core, self.generated_classes + 4 + bucket * 4).unwrap_or(0);
+            while ptr_class != 0 && classes.len() < 0x10000 {
+                let Some(descriptor) = read_generic::<RawJavaClass, _>(&self.core, ptr_class)
+                    .and_then(|raw| read_generic::<RawJavaClassDescriptor, _>(&self.core, raw.ptr_descriptor))
+                    .ok()
+                else {
+                    break;
+                };
+                ptr_class = descriptor.ptr_next_class;
+                classes.push(descriptor);
+            }
+        }
+        classes
+    }
+
+    fn live_class(&self, object: u32) -> Option<(JavaClassDefinition, u32)> {
+        if !JavaClassInstance::is_live_instance(&self.core, object) {
+            return None;
+        }
+        let instance = JavaClassInstance::from_raw(object, &self.core);
+        Some((instance.class().ok()?, instance.ptr_fields().ok()?))
+    }
+}
+
+fn word_size(descriptor: &str) -> u32 {
+    if matches!(descriptor, "J" | "D") { 8 } else { 4 }
+}
+
+impl JavaHeap for LgtJavaHeap {
+    fn class_names(&self) -> Vec<String> {
+        let platform = wie_wipi_java::get_protos()
+            .into_iter()
+            .map(|x| x.name)
+            .chain(wie_midp::get_protos().into_iter().map(|x| x.name));
+        let platform = platform.filter(|name| self.jvm.has_class(name)).map(String::from);
+        self.generated()
+            .into_iter()
+            .filter(|descriptor| descriptor.link_state == LINKED)
+            .filter_map(|descriptor| guest_name(&self.core, descriptor.ptr_name).ok().map(|x| x.to_string()))
+            .chain(platform)
+            .collect()
+    }
+
+    fn static_fields(&self, class: &str) -> Vec<JavaSlot> {
+        let Some(class) = self.class(class) else {
+            return Vec::new();
+        };
+        let Ok(base) = class.ptr_static_fields() else {
+            return Vec::new();
+        };
+        let mut slots: Vec<JavaSlot> = class
+            .declared_fields()
+            .unwrap_or_default()
+            .into_iter()
+            .filter(|field| field.access_flags().contains(FieldAccessFlags::STATIC))
+            .filter_map(|field| {
+                let descriptor = field.descriptor().into_owned();
+                Some(JavaSlot {
+                    name: field.name().into_owned(),
+                    address: base + field.word_index().ok()? * size_of::<LgtJvmWord>() as u32,
+                    size: word_size(&descriptor),
+                    descriptor,
+                })
+            })
+            .collect();
+        // The compiler keeps no names for an application class's own static fields, only a count of words:
+        // name each word `$N` by its index (stable for a given binary). The storage is untyped, so a word that
+        // holds a live object is a reference and anything else reads as an int.
+        let words = class.descriptor().map(|x| x.static_field_word_count).unwrap_or(0).min(0x4000);
+        for word in 0..words {
+            let address = base + word * size_of::<LgtJvmWord>() as u32;
+            if slots.iter().any(|x| x.address <= address && address < x.address + x.size) {
+                continue;
+            }
+            let value: u32 = read_generic(&self.core, address).unwrap_or(0);
+            let descriptor = match self.live_class(value) {
+                Some((class, _)) => {
+                    let name = ClassDefinition::name(&class);
+                    if name.starts_with('[') { name.into_owned() } else { format!("L{name};") }
+                }
+                None => "I".into(),
+            };
+            slots.push(JavaSlot {
+                name: format!("${word}"),
+                descriptor,
+                address,
+                size: 4,
+            });
+        }
+        slots
+    }
+
+    fn object(&self, object: u32) -> Option<(String, Vec<JavaSlot>)> {
+        let (class, ptr_fields) = self.live_class(object)?;
+        let name = ClassDefinition::name(&class).into_owned();
+        if name.starts_with('[') {
+            return Some((name, Vec::new()));
+        }
+        let mut chain = Vec::new();
+        let mut current = Some(class);
+        while let Some(class) = current {
+            current = self.super_class(&class);
+            chain.push(class);
+            if chain.len() > 64 {
+                return None;
+            }
+        }
+        let mut slots = Vec::new();
+        for class in chain.iter().rev() {
+            for field in class.declared_fields().ok()? {
+                // Detached fields are runtime-only platform state, not guest-visible words.
+                if field.access_flags().contains(FieldAccessFlags::STATIC) || field.is_detached().ok()? {
+                    continue;
+                }
+                let descriptor = field.descriptor().into_owned();
+                slots.push(JavaSlot {
+                    name: field.name().into_owned(),
+                    address: ptr_fields + field.word_index().ok()? * size_of::<LgtJvmWord>() as u32,
+                    size: word_size(&descriptor),
+                    descriptor,
+                });
+            }
+        }
+        Some((name, slots))
+    }
+
+    fn array(&self, object: u32) -> Option<JavaArray> {
+        let (class, ptr_fields) = self.live_class(object)?;
+        let element = ClassDefinition::name(&class).strip_prefix('[')?.to_string();
+        let element_size = array_element_size(&JavaType::try_parse(&element)?) as u32;
+        let length: u32 = read_generic(&self.core, ptr_fields).ok()?;
+        // Narrow elements follow the length word; long and double elements start 8-byte aligned.
+        let data = if element_size == 8 { 8 } else { 4 };
+
+        Some(JavaArray {
+            element,
+            length,
+            address: ptr_fields + data,
+            element_size,
+        })
+    }
+}
