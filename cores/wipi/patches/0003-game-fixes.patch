+    let value: Vec<i64> = jvm
+        .load_array(&array, index as usize, 1)
+        .await
+        .map_err(|JavaError::JavaException(instance)| WieError::JavaException(LgtJvmSupport::class_instance_raw(&*instance)))?;
+
+    Ok(LongResult(value[0]))
