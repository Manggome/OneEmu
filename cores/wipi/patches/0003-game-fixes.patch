+    /// Compares the guest name at `ptr` with `descriptor+name` in place: member lookups scan whole
+    /// tables, and materializing every candidate's name dominated frame time in API-heavy games.
+    pub fn matches(core: &ArmCore, ptr: u32, name: &str, descriptor: &str) -> Result<bool> {
+        let mut expected = descriptor.bytes().chain(Some(b'+')).chain(name.bytes()).chain(Some(0));
+        let mut cursor = ptr + 1;
+        let mut buffer = [0; 32];
+        loop {
