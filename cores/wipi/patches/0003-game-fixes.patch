+                // The terminator may precede an unmapped byte in this chunk.
+                Err(WieError::InvalidMemoryAccess(_)) => core.read_bytes(cursor, &mut buffer[..1])?,
+                result => result?,
+            };
+            if size == 0 {
+                return Ok(false);
+            }
+            for &byte in &buffer[..size] {
+                match expected.next() {
+                    Some(0) => return Ok(byte == 0),
+                    Some(x) if x == byte => {}
+                    _ => return Ok(false),
+                }
+            }
+            cursor = cursor.wrapping_add(size as u32);
+        }
+    }
