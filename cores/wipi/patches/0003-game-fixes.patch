+impl GuestMemory for ArmCore {
+    fn mapped_ranges(&self) -> Vec<(u32, u32)> {
+        const PAGE: u32 = 0x10000;
+        let inner = self.inner.lock();
+        let mut ranges: Vec<(u32, u32)> = Vec::new();
+        for page in 0..0x10000u32 {
+            let start = page * PAGE;
+            if !inner.engine.is_mapped(start, PAGE as usize) {
+                continue;
+            }
+            match ranges.last_mut() {
+                Some((s, len)) if s.wrapping_add(*len) == start => *len += PAGE,
+                _ => ranges.push((start, PAGE)),
+            }
+        }
+        ranges
+    }
+
+    fn read(&self, address: u32, buf: &mut [u8]) -> wie_util::Result<()> {
+        self.read_bytes(address, buf).map(|_| ())
+    }
