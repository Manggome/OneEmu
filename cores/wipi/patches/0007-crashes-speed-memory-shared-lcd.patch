+/// The screen framebuffer (`MC_grpGetScreenFrameBuffer`) if the app has one and its pixels changed since
+/// `last_hash` (updated); the first sight of the buffer only records its hash. Games that draw into it and then
+/// present through a Java repaint instead of `MC_grpFlushLcd` rely on it being the LCD that Java paints on.
+pub fn screen_image_if_changed(context: &mut dyn WIPICContext, last_hash: &mut Option<u64>) -> Result<Option<Box<dyn Image>>> {
+    let framebuffer_ptr: u32 = read_generic(context, SCREEN_FRAMEBUFFER_PTR)?;
+    if framebuffer_ptr == 0 {
+        return Ok(None);
+    }
+    let framebuffer = FrameBuffer(read_generic(context, context.data_ptr(WIPICIndirectPtr(framebuffer_ptr))?)?);
+    let image = framebuffer.image(context)?;
+
+    // 64-bit FNV-1a over the pixels
+    let hash = image.raw().iter().fold(0xcbf2_9ce4_8422_2325u64, |hash, byte| {
