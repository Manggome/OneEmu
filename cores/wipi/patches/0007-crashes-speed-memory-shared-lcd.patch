diff --git a/wie-lgt/src/runtime/java/jvm_support/names.rs b/wie-lgt/src/runtime/java/jvm_support/names.rs
new file mode 100644
index 00000000..5401cf28
--- /dev/null
+++ b/wie-lgt/src/runtime/java/jvm_support/names.rs
@@ -0,0 +1,44 @@
+use alloc::{collections::BTreeMap, string::String, sync::Arc};
+
+use wie_core_arm::ArmCore;
+use wie_util::{Result, WieError, read_null_terminated_string_bytes};
+
+/// Class, field and method names and descriptors by guest address. They are read for every lookup by name
+/// and for every object the garbage collector visits, but they are written once (by the compiler or when
+/// the platform defines a class) and never freed, so each address is decoded only once per core.
+#[derive(Default)]
+struct GuestNames(BTreeMap<u32, Arc<str>>);
+
+/// Field or method found by name in one class's table, keyed by (class, table address, [`member_key`],
+/// is_static); `None` = not declared there. Tables are rebuilt at a new address when a class gains members,
+/// so a key with the table address stays valid. Host code looks members up by name for nearly every call
+/// (`Graphics` reads its fields on every draw), which otherwise scans the table and decodes every name.
+#[derive(Default)]
+pub struct MemberLookups(pub BTreeMap<(u32, u32, u64, bool), Option<u32>>);
+
+#[derive(Default)]
+pub struct FieldLookups(pub MemberLookups);
+
+#[derive(Default)]
+pub struct MethodLookups(pub MemberLookups);
+
+/// 64-bit FNV-1a of `name` and `descriptor`.
+pub fn member_key(name: &str, descriptor: &str) -> u64 {
+    let mut hash = 0xcbf2_9ce4_8422_2325u64;
+    for byte in name.bytes().chain(core::iter::once(0)).chain(descriptor.bytes()) {
+        hash = (hash ^ byte as u64).wrapping_mul(0x0100_0000_01b3);
+    }
+    hash
+}
+
+pub fn guest_name(core: &ArmCore, address: u32) -> Result<Arc<str>> {
+    if let Some(name) = core.with_extension(|names: &mut GuestNames| names.0.get(&address).cloned()) {
+        return Ok(name);
+    }
+    let bytes = read_null_terminated_string_bytes(core, address)?;
+    let name: Arc<str> = String::from_utf8(bytes)
+        .map_err(|_| WieError::FatalError(alloc::format!("invalid name at {address:#x}")))?
+        .into();
+    core.with_extension(|names: &mut GuestNames| names.0.insert(address, name.clone()));
+    Ok(name)
+}
