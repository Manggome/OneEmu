@@ -0,0 +1,77 @@
+use jvm::{ClassInstanceRef, Jvm, Result as JvmResult};
+use jvm_class_proto::{JavaFieldProto, JavaMethodProto};
+use jvm_types::{FieldAccessFlags, MethodAccessFlags};
+use rustjava_runtime::{RuntimeClassProto, RuntimeContext};
+
+use wie_backend::Platform;
+
+/// Class holding the collection schedule in two static fields: every platform has it, and the schedule then
+/// lives exactly as long as the JVM it belongs to.
+const SCHEDULE_CLASS: &str = "java/lang/System";
+/// Low 32 bits of the platform time of the last scheduled collection (0 = none yet).
+const LAST_COLLECTION: &str = "wieLastGarbageCollection";
+/// Milliseconds until the next scheduled collection, from the last one's cost (0 = the minimum).
+const COLLECTION_INTERVAL: &str = "wieGarbageCollectionInterval";
+
+const MIN_INTERVAL_MS: i32 = 1000;
+/// Longest wait between collections, however long the last one took.
+const MAX_INTERVAL_MS: i32 = 8000;
+/// Game time between collections per millisecond the last collection took: keeps collecting at about 4% of
+/// game time on large heaps.
+const COST_FACTOR: i32 = 25;
+
+/// Collects garbage at a safe point (no host code holds unrooted objects) unless the last collection ran
+/// recently: [`MIN_INTERVAL_MS`] of game time, or longer when it was slow. A full collection walks every
+/// reachable object; once per paint it dominated frame time in paint-heavy games, once per resource access
+/// it stalled KTF games that load many resources in a row (메이플스토리 도적편: ~180 ms frames while
+/// loading), and even once a second it took ~40% of the CPU of LGT 슈퍼액션히어로 at full speed.
+pub async fn collect_garbage_periodically(jvm: &Jvm, platform: &dyn Platform) -> JvmResult<()> {
+    collect_on_schedule(jvm, &|| platform.now().raw()).await
+}
+
+async fn collect_on_schedule(jvm: &Jvm, now: &(dyn Fn() -> u64 + Sync)) -> JvmResult<()> {
+    let started = now() as i32;
+    let last: i32 = jvm.get_static_field(SCHEDULE_CLASS, LAST_COLLECTION, "I").await?;
+    let interval: i32 = jvm.get_static_field(SCHEDULE_CLASS, COLLECTION_INTERVAL, "I").await?;
+    if last != 0 && (0..interval.max(MIN_INTERVAL_MS)).contains(&started.wrapping_sub(last)) {
+        return Ok(());
+    }
+    jvm.put_static_field(SCHEDULE_CLASS, LAST_COLLECTION, "I", if started == 0 { 1 } else { started })
+        .await?;
+    jvm.collect_garbage()?;
+
+    let cost = (now() as i32).wrapping_sub(started).max(0);
+    let interval = cost.saturating_mul(COST_FACTOR).clamp(MIN_INTERVAL_MS, MAX_INTERVAL_MS);
+    jvm.put_static_field(SCHEDULE_CLASS, COLLECTION_INTERVAL, "I", interval).await?;
+
+    Ok(())
+}
+
+/// `System.gc()` and `Runtime.gc()` collect on the same schedule. Games call them at will (놈3: several
+/// times a second on some screens, ~150 ms each on its heap); collecting is only a hint in Java, and the
+/// guest heap is far larger than the handsets' so the delay costs nothing but memory held a little longer.
+pub(crate) fn schedule_explicit_collections(class: &str, proto: &mut RuntimeClassProto) {
+    async fn system_gc(jvm: &Jvm, context: &mut RuntimeContext) -> JvmResult<()> {
+        collect_on_schedule(jvm, &|| context.now()).await
+    }
+
+    async fn runtime_gc(jvm: &Jvm, context: &mut RuntimeContext, _: ClassInstanceRef<()>) -> JvmResult<()> {
+        collect_on_schedule(jvm, &|| context.now()).await
+    }
+
+    let gc: fn(MethodAccessFlags) -> JavaMethodProto<RuntimeContext> = match class {
+        "java/lang/System" => {
+            for name in [LAST_COLLECTION, COLLECTION_INTERVAL] {
+                proto
+                    .fields
+                    .push(JavaFieldProto::new(name, "I", FieldAccessFlags::PRIVATE | FieldAccessFlags::STATIC));
+            }
+            |flags| JavaMethodProto::new("gc", "()V", system_gc, flags)
+        }
+        "java/lang/Runtime" => |flags| JavaMethodProto::new("gc", "()V", runtime_gc, flags),
+        _ => return,
+    };
+    if let Some(method) = proto.methods.iter_mut().find(|method| method.name == "gc" && method.descriptor == "()V") {
+        *method = gc(method.access_flags);
+    }
+}
