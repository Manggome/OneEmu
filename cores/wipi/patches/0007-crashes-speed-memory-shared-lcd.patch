+/// Writes as many whole characters of `text` as fit, in the handset encoding, and NUL-terminates
+/// when there is room.
+fn write_text(context: &mut dyn WIPICContext, text: &str, ptr_buf: WIPICWord, ptr_size: WIPICWord) -> Result<()> {
+    if ptr_buf == 0 || ptr_size == 0 {
+        return Ok(());
+    }
+
+    let capacity = read_generic::<i32, _>(context, ptr_size)?.max(0) as usize;
+    let mut bytes = Vec::new();
+    for c in text.chars() {
+        let mut utf8 = [0; 4];
+        let encoded = encoding_rs::EUC_KR.encode(c.encode_utf8(&mut utf8)).0;
+        if bytes.len() + encoded.len() > capacity {
+            break;
+        }
+        bytes.extend_from_slice(&encoded);
+    }
+
+    context.write_bytes(ptr_buf, &bytes)?;
+    if bytes.len() < capacity {
+        context.write_bytes(ptr_buf + bytes.len() as u32, &[0])?;
+    }
+    write_generic(context, ptr_size, bytes.len() as i32)
+}
