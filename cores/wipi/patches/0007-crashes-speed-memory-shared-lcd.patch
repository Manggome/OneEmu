+//! The handset's text input method: keypad presses in, committed and composing text out.
+//!
+//! Latin letters use multi-tap on the ITU-T E.161 keypad; Hangul uses the 천지인 keypad
+//! (1 = ㅣ, 2 = ㆍ, 3 = ㅡ build vowels; 4-9 and 0 cycle consonant groups). A key that
+//! does not enter text finishes the composition, which is also how a separate letter on
+//! the same key is entered.
+
+use alloc::{string::String, vec::Vec};
+
+#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]
+pub enum InputMode {
+    #[default]
+    Upper,
+    Lower,
+    Digits,
+    Hangul,
+}
+
+#[derive(Debug, Default, Eq, PartialEq)]
+pub struct InputOutput {
+    /// Text the input method has finished with.
+    pub committed: String,
+    /// Text still being composed; the next key can change it.
+    pub composing: String,
+}
+
+#[derive(Default)]
+pub struct InputMethod {
+    mode: InputMode,
+    multi_tap: Option<(char, usize)>,
+    hangul: Vec<Token>,
+}
+
+impl InputMethod {
+    pub fn mode(&self) -> InputMode {
+        self.mode
+    }
+
+    /// Switches the mode. Text still being composed is dropped; callers finish it first.
+    pub fn set_mode(&mut self, mode: InputMode) {
+        self.mode = mode;
+        self.multi_tap = None;
+        self.hangul.clear();
+    }
+
+    /// Feeds one key press. `key` is a keypad character (`'0'..='9'`, `'*'`, `'#'`) or `None`
+    /// for any other key, which finishes the composition.
+    pub fn press(&mut self, key: Option<char>) -> InputOutput {
+        let mut output = InputOutput::default();
+
+        match self.mode {
+            InputMode::Upper | InputMode::Lower => self.press_multi_tap(key, &mut output),
+            InputMode::Digits => {
+                if let Some(key) = key {
+                    output.committed.push(key);
+                }
+            }
+            InputMode::Hangul => self.press_hangul(key, &mut output),
+        }
+
+        output
+    }
+
+    fn press_multi_tap(&mut self, key: Option<char>, output: &mut InputOutput) {
+        let letters = key.map(multi_tap_letters).unwrap_or("");
+        match self.multi_tap {
+            Some((pending, index)) if Some(pending) == key && !letters.is_empty() => {
+                self.multi_tap = Some((pending, (index + 1) % letters.chars().count()));
+            }
+            pending => {
+                if let Some((pending, index)) = pending {
+                    output.committed.push(multi_tap_char(pending, index, self.mode));
+                }
+                self.multi_tap = key.filter(|_| !letters.is_empty()).map(|key| (key, 0));
+            }
+        }
+
+        if let Some((pending, index)) = self.multi_tap {
+            output.composing.push(multi_tap_char(pending, index, self.mode));
+        }
+    }
+
+    fn press_hangul(&mut self, key: Option<char>, output: &mut InputOutput) {
+        match key.and_then(hangul_key) {
+            Some(HangulKey::Stroke(stroke)) => {
+                let extended = match self.hangul.last() {
+                    Some(Token::Vowel(strokes)) => {
+                        let mut strokes = strokes.clone();
+                        strokes.push(stroke);
+                        vowel(&strokes).map(|_| strokes)
+                    }
+                    _ => None,
+                };
+                match extended {
+                    Some(strokes) => *self.hangul.last_mut().unwrap() = Token::Vowel(strokes),
+                    None => self.hangul.push(Token::Vowel(String::from(stroke))),
+                }
+            }
+            Some(HangulKey::Consonant(group)) => match self.hangul.last_mut() {
+                Some(Token::Consonant(last, index)) if *last == group => *index = (*index + 1) % group.chars().count(),
+                _ => self.hangul.push(Token::Consonant(group, 0)),
+            },
+            None => {
+                output.committed.push_str(&render(&self.hangul).text);
+                self.hangul.clear();
+                return;
+            }
+        }
+
+        let rendered = render(&self.hangul);
+        if let Some(last) = rendered.syllables.last() {
+            output.committed.push_str(&rendered.text[..last.text_start]);
+            self.hangul.drain(..last.first_token);
+            output.composing.push_str(&rendered.text[last.text_start..]);
+        }
+    }
+}
+
+fn multi_tap_letters(key: char) -> &'static str {
+    match key {
+        '1' => ".,?!1",
+        '2' => "abc2",
+        '3' => "def3",
+        '4' => "ghi4",
+        '5' => "jkl5",
+        '6' => "mno6",
+        '7' => "pqrs7",
+        '8' => "tuv8",
+        '9' => "wxyz9",
+        '0' => " 0",
+        _ => "",
+    }
+}
+
+fn multi_tap_char(key: char, index: usize, mode: InputMode) -> char {
+    let letter = multi_tap_letters(key).chars().nth(index).unwrap_or(key);
+    if mode == InputMode::Upper { letter.to_ascii_uppercase() } else { letter }
+}
+
+const IOTA: char = 'ㅣ';
+const DOT: char = 'ㆍ';
+const BAR: char = 'ㅡ';
+
+enum HangulKey {
+    Stroke(char),
+    Consonant(&'static str),
+}
+
+fn hangul_key(key: char) -> Option<HangulKey> {
+    Some(match key {
+        '1' => HangulKey::Stroke(IOTA),
+        '2' => HangulKey::Stroke(DOT),
+        '3' => HangulKey::Stroke(BAR),
+        '4' => HangulKey::Consonant("ㄱㅋㄲ"),
+        '5' => HangulKey::Consonant("ㄴㄹ"),
+        '6' => HangulKey::Consonant("ㄷㅌㄸ"),
+        '7' => HangulKey::Consonant("ㅂㅍㅃ"),
+        '8' => HangulKey::Consonant("ㅅㅎㅆ"),
+        '9' => HangulKey::Consonant("ㅈㅊㅉ"),
+        '0' => HangulKey::Consonant("ㅇㅁ"),
+        _ => return None,
+    })
+}
+
+enum Token {
+    /// A consonant key group and the position reached by pressing it repeatedly.
+    Consonant(&'static str, usize),
+    /// Vowel strokes in the order they were pressed.
+    Vowel(String),
+}
+
+impl Token {
+    fn consonant(&self) -> Option<char> {
+        match self {
+            Token::Consonant(group, index) => group.chars().nth(*index),
+            Token::Vowel(_) => None,
+        }
+    }
+}
+
+enum Vowel {
+    Complete(char),
+    /// ㆍ or ㆍㆍ: a stroke sequence that becomes a vowel once ㅣ or ㅡ follows.
+    Partial,
+}
+
+fn vowel(strokes: &str) -> Option<Vowel> {
+    Some(Vowel::Complete(match strokes {
+        "ㆍ" | "ㆍㆍ" => return Some(Vowel::Partial),
+        "ㅣ" => 'ㅣ',
+        "ㅡ" => 'ㅡ',
+        "ㅣㆍ" => 'ㅏ',
+        "ㅣㆍㆍ" => 'ㅑ',
+        "ㆍㅣ" => 'ㅓ',
+        "ㆍㆍㅣ" => 'ㅕ',
+        "ㆍㅡ" => 'ㅗ',
+        "ㆍㆍㅡ" => 'ㅛ',
+        "ㅡㆍ" => 'ㅜ',
+        "ㅡㆍㆍ" => 'ㅠ',
+        "ㅣㆍㅣ" => 'ㅐ',
+        "ㅣㆍㆍㅣ" => 'ㅒ',
+        "ㆍㅣㅣ" => 'ㅔ',
+        "ㆍㆍㅣㅣ" => 'ㅖ',
+        "ㆍㅡㅣ" => 'ㅚ',
+        "ㆍㅡㅣㆍ" => 'ㅘ',
+        "ㆍㅡㅣㆍㅣ" => 'ㅙ',
+        "ㅡㆍㅣ" => 'ㅟ',
+        "ㅡㆍㆍㅣ" => 'ㅝ',
+        "ㅡㆍㆍㅣㅣ" => 'ㅞ',
+        "ㅡㅣ" => 'ㅢ',
+        _ => return None,
+    }))
+}
+
+const INITIALS: &str = "ㄱㄲㄴㄷㄸㄹㅁㅂㅃㅅㅆㅇㅈㅉㅊㅋㅌㅍㅎ";
+const MEDIALS: &str = "ㅏㅐㅑㅒㅓㅔㅕㅖㅗㅘㅙㅚㅛㅜㅝㅞㅟㅠㅡㅢㅣ";
+const FINALS: &str = "ㄱㄲㄳㄴㄵㄶㄷㄹㄺㄻㄼㄽㄾㄿㅀㅁㅂㅄㅅㅆㅇㅈㅊㅋㅌㅍㅎ";
+
+fn position(table: &str, jamo: char) -> Option<u32> {
+    table.chars().position(|x| x == jamo).map(|x| x as u32)
+}
+
+fn double_final(first: char, second: char) -> Option<char> {
+    Some(match (first, second) {
+        ('ㄱ', 'ㅅ') => 'ㄳ',
+        ('ㄴ', 'ㅈ') => 'ㄵ',
+        ('ㄴ', 'ㅎ') => 'ㄶ',
+        ('ㄹ', 'ㄱ') => 'ㄺ',
+        ('ㄹ', 'ㅁ') => 'ㄻ',
+        ('ㄹ', 'ㅂ') => 'ㄼ',
+        ('ㄹ', 'ㅅ') => 'ㄽ',
+        ('ㄹ', 'ㅌ') => 'ㄾ',
+        ('ㄹ', 'ㅍ') => 'ㄿ',
+        ('ㄹ', 'ㅎ') => 'ㅀ',
+        ('ㅂ', 'ㅅ') => 'ㅄ',
+        _ => return None,
+    })
+}
+
+/// One syllable block being assembled from tokens (indices into the token list).
+#[derive(Default)]
+struct Block {
+    initial: Option<usize>,
+    medial: Option<usize>,
+    finals: Vec<usize>,
+}
+
+impl Block {
+    fn is_empty(&self) -> bool {
+        self.initial.is_none() && self.medial.is_none()
+    }
+
+    fn first_token(&self) -> usize {
+        self.initial.or(self.medial).unwrap()
+    }
+}
+
+struct Syllable {
+    first_token: usize,
+    text_start: usize,
+}
+
+struct Rendered {
+    text: String,
+    syllables: Vec<Syllable>,
+}
+
+fn render(tokens: &[Token]) -> Rendered {
+    let mut blocks: Vec<Block> = Vec::new();
+    let mut block = Block::default();
+
+    for (index, token) in tokens.iter().enumerate() {
+        match token {
+            Token::Consonant(..) => {
+                let consonant = token.consonant().unwrap();
+                let medial = block.medial.map(|x| match &tokens[x] {
+                    Token::Vowel(strokes) => vowel(strokes),
+                    Token::Consonant(..) => None,
+                });
+                let joins = match (block.initial, medial, block.finals.as_slice()) {
+                    (Some(_), Some(Some(Vowel::Complete(_))), []) => position(FINALS, consonant).is_some(),
+                    (Some(_), Some(Some(Vowel::Complete(_))), [first]) => double_final(tokens[*first].consonant().unwrap(), consonant).is_some(),
+                    _ => false,
+                };
+                if joins {
+                    block.finals.push(index);
+                } else {
+                    if !block.is_empty() {
+                        blocks.push(core::mem::take(&mut block));
+                    }
+                    block.initial = Some(index);
+                }
+            }
+            Token::Vowel(_) => {
+                if block.medial.is_none() && block.finals.is_empty() {
+                    block.medial = Some(index);
+                } else {
+                    // A vowel after a final consonant takes it as its initial.
+                    let initial = block.finals.pop();
+                    if !block.is_empty() {
+                        blocks.push(core::mem::take(&mut block));
+                    }
+                    block.initial = initial;
+                    block.medial = Some(index);
+                }
+            }
+        }
+    }
+    if !block.is_empty() {
+        blocks.push(block);
+    }
+
+    let mut text = String::new();
+    let syllables = blocks
+        .iter()
+        .map(|block| {
+            let text_start = text.len();
+            render_block(tokens, block, &mut text);
+            Syllable {
+                first_token: block.first_token(),
+                text_start,
+            }
+        })
+        .collect();
+
+    Rendered { text, syllables }
+}
+
+fn render_block(tokens: &[Token], block: &Block, text: &mut String) {
+    let initial = block.initial.and_then(|x| tokens[x].consonant());
+    let strokes = block.medial.map(|x| match &tokens[x] {
+        Token::Vowel(strokes) => strokes.as_str(),
+        Token::Consonant(..) => "",
+    });
+    let medial = strokes.and_then(vowel);
+    let finals: Vec<char> = block.finals.iter().filter_map(|x| tokens[*x].consonant()).collect();
+
+    if let (Some(initial), Some(Vowel::Complete(medial))) = (initial, &medial) {
+        let final_jamo = match finals.as_slice() {
+            [] => None,
+            [single] => Some(*single),
+            [first, second] => double_final(*first, *second),
+            _ => None,
+        };
+        let code = 0xac00
+            + (position(INITIALS, initial).unwrap() * 21 + position(MEDIALS, *medial).unwrap()) * 28
+            + final_jamo.and_then(|x| position(FINALS, x)).map(|x| x + 1).unwrap_or(0);
+        text.push(char::from_u32(code).unwrap());
+        return;
+    }
+
+    if let Some(initial) = initial {
+        text.push(initial);
+    }
+    match medial {
+        Some(Vowel::Complete(medial)) => text.push(medial),
+        Some(Vowel::Partial) => text.push_str(strokes.unwrap()),
+        None => {}
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use alloc::string::String;
+
+    use super::{InputMethod, InputMode};
+
+    fn type_keys(input: &mut InputMethod, keys: &str) -> (String, String) {
+        let mut committed = String::new();
+        let mut composing = String::new();
+        for key in keys.chars() {
+            let output = input.press(if key == '>' { None } else { Some(key) });
+            committed.push_str(&output.committed);
+            composing = output.composing;
+        }
+
+        (committed, composing)
+    }
+
+    fn hangul(keys: &str) -> (String, String) {
+        let mut input = InputMethod::default();
+        input.set_mode(InputMode::Hangul);
+
+        type_keys(&mut input, keys)
+    }
+
+    #[test]
+    fn multi_tap_cycles_one_key_and_commits_on_another() {
+        let mut input = InputMethod::default();
+        input.set_mode(InputMode::Lower);
+
+        assert_eq!(type_keys(&mut input, "4433"), ("h".into(), "e".into()));
+        assert_eq!(type_keys(&mut input, "555>555"), ("el".into(), "l".into()));
+
+        input.set_mode(InputMode::Upper);
+        assert_eq!(type_keys(&mut input, "22>"), ("B".into(), "".into()));
+    }
+
+    #[test]
+    fn digits_commit_at_once() {
+        let mut input = InputMethod::default();
+        input.set_mode(InputMode::Digits);
+
+        assert_eq!(type_keys(&mut input, "12#"), ("12#".into(), "".into()));
+    }
+
+    #[test]
+    fn hangul_builds_syllables_from_strokes_and_consonant_groups() {
+        // 한 = ㅎ(88) ㅏ(12) ㄴ(5); 글 = ㄱ(4) ㅡ(3) ㄹ(55)
+        assert_eq!(hangul("88125"), ("".into(), "한".into()));
+        assert_eq!(hangul("881254355"), ("한".into(), "글".into()));
+        // A vowel after a final consonant takes it: 가 + ㄱ + ㅣ → 가기
+        assert_eq!(hangul("4124"), ("".into(), "각".into()));
+        assert_eq!(hangul("41241"), ("가".into(), "기".into()));
+        // Double finals and compound vowels: 닭 (ㄷ ㅏ ㄹ ㄱ), 왜 (ㅇ ㅗ ㅏ ㅣ)
+        assert_eq!(hangul("612554"), ("".into(), "닭".into()));
+        assert_eq!(hangul("023121"), ("".into(), "왜".into()));
+        // A key outside the keypad separates two consonants from the same key: 각개 vs 갘
+        assert_eq!(hangul("4124>4121"), ("각".into(), "개".into()));
+        assert_eq!(hangul("41244"), ("".into(), "갘".into()));
+    }
+
+    #[test]
+    fn hangul_shows_unfinished_vowels() {
+        assert_eq!(hangul("42"), ("".into(), "ㄱㆍ".into()));
+        assert_eq!(hangul("421"), ("".into(), "거".into()));
+        assert_eq!(hangul("4>"), ("ㄱ".into(), "".into()));
+    }
+}
