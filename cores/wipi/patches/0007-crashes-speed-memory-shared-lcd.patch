+
+/// `MC_netSocketConnect(fd, addr, port, cb, param)`: the attempt starts (M_E_SUCCESS) and is never answered, like a
+/// connection whose packets go nowhere, so the game's own timeout reports the failure. 테일즈위버 ignores a failed
+/// MC_netConnect and opens a socket anyway; when the socket or this call fails, or the callback reports an error, it
+/// only frees its buffers and leaves "네트워크에 접속중입니다" up for good. Its 30-second timeout is the one path that
+/// shows "서버접속에 실패했습니다" and lets the player go on.
+pub async fn socket_connect(_context: &mut dyn WIPICContext, fd: i32, addr: WIPICWord, port: i32, cb: WIPICWord, param: WIPICWord) -> Result<i32> {
+    tracing::warn!("offline MC_netSocketConnect({fd}, {addr:#x}, {port}, {cb:#x}, {param:#x}): never answered");
+
+    Ok(0) // M_E_SUCCESS: in progress
+}
