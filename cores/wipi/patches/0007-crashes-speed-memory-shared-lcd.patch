@@ -0,0 +1,32 @@
+use alloc::{boxed::Box, collections::BTreeMap, vec::Vec};
+
+/// Fields or methods found by name in one class's member table: per (class, table address, is_static), the
+/// names looked up so far and what they resolved to (`None` = not declared there). Host code looks members
+/// up by name on nearly every call (`Graphics` reads its fields on every draw) and the JVM resolves every
+/// invocation the same way, which otherwise scans the guest table and compares names in guest memory.
+///
+/// KTF member tables and the member records' names and owners are written once (by the compiler in
+/// client.bin, or when the platform defines a class) and classes are never freed, so a result stays valid;
+/// the table address in the key covers a class whose table were ever replaced.
+#[derive(Default)]
+pub struct MemberLookups(BTreeMap<(u32, u32, bool), Vec<(Box<str>, Box<str>, Option<u32>)>>);
+
+impl MemberLookups {
+    pub fn get(&self, key: (u32, u32, bool), name: &str, descriptor: &str) -> Option<Option<u32>> {
+        self.0
+            .get(&key)?
+            .iter()
+            .find(|(cached_name, cached_descriptor, _)| **cached_name == *name && **cached_descriptor == *descriptor)
+            .map(|(_, _, found)| *found)
+    }
+
+    pub fn insert(&mut self, key: (u32, u32, bool), name: &str, descriptor: &str, found: Option<u32>) {
+        self.0.entry(key).or_default().push((name.into(), descriptor.into(), found));
+    }
+}
+
+#[derive(Default)]
+pub struct FieldLookups(pub MemberLookups);
+
+#[derive(Default)]
+pub struct MethodLookups(pub MemberLookups);
