+/// `MC_uicGetTime(control, tm)`: writes the current time (UTC, as the kernel's clock) as a C `struct tm`: seconds,
+/// minutes, hours, day of month, month 0-11, years since 1900 and day of week. Games make a date control just to read
+/// the date: 질주쾌감스케쳐 2 (KTF) asks for a DateTimeComponent, which is no control here, and reads the year, month,
+/// day and weekday, so it answers on any control.
+pub async fn get_time(context: &mut dyn WIPICContext, control: WIPICWord, out_ptr: WIPICWord) -> Result<i32> {
+    tracing::debug!("MC_uicGetTime({control:#x}, {out_ptr:#x})");
 
-    if ptr_buf != 0 && size > 0 {
-        context.write_bytes(ptr_buf, &[0])?;
+    if out_ptr == 0 {
+        return Ok(M_E_ERROR);
+    }
+    let timestamp = (context.system().platform().now().raw() / 1000) as i64;
+    let days = timestamp.div_euclid(86_400);
+    let seconds_of_day = timestamp.rem_euclid(86_400);
+    let (year, month, day) = civil_from_days(days);
+    let (hour, minute, second) = (seconds_of_day / 3600, (seconds_of_day % 3600) / 60, seconds_of_day % 60);
+    let weekday = (days + 4).rem_euclid(7); // 1970-01-01 was a Thursday
+
+    for (index, value) in [second, minute, hour, day, month - 1, year - 1900, weekday].into_iter().enumerate() {
+        write_generic(context, out_ptr + index as u32 * 4, value as i32)?;
     }
 
     Ok(0)
 }
+
+fn civil_from_days(days: i64) -> (i64, i64, i64) {
+    let days = days + 719_468;
+    let era = if days >= 0 { days } else { days - 146_096 } / 146_097;
+    let day_of_era = days - era * 146_097;
+    let year_of_era = (day_of_era - day_of_era / 1460 + day_of_era / 36_524 - day_of_era / 146_096) / 365;
+    let mut year = year_of_era + era * 400;
+    let day_of_year = day_of_era - (365 * year_of_era + year_of_era / 4 - year_of_era / 100);
+    let month_param = (5 * day_of_year + 2) / 153;
+    let day = day_of_year - (153 * month_param + 2) / 5 + 1;
+    let month = month_param + if month_param < 10 { 3 } else { -9 };
+    year += if month <= 2 { 1 } else { 0 };
+
+    (year, month, day)
+}
