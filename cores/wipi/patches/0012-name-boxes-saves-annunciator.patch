+    /// Runs `f` on the platform state of type `T` (created with `Default` on first use). API layers keep their
+    /// own handset state here, such as WIPI-C's UI controls. `f` must not ask for another state.
+    pub fn with_state<T, R>(&self, f: impl FnOnce(&mut T) -> R) -> R
+    where
+        T: Any + Default + Send + Sync,
+    {
+        let mut states = self.inner.states.write();
