+/// `MC_uicDeleteText(control, position, count)`: characters from `position`, all of them for a negative count.
+pub async fn delete_text(context: &mut dyn WIPICContext, cc: WIPICWord, position: i32, count: i32) -> Result<i32> {
+    tracing::debug!("MC_uicDeleteText({cc:#x}, {position}, {count})");
+
+    let system = context.system().clone();
+    let deleted = with_control(context, cc, |control| {
+        let start = (position.max(0) as usize).min(control.text.len());
+        let end = match usize::try_from(count) {
+            Ok(count) => (start + count).min(control.text.len()),
+            Err(_) => control.text.len(),
+        };
+        control.text.drain(start..end);
+        if control.cursor > start {
+            control.cursor = start.max(control.cursor - (end - start));
+        }
+        if !control.composing.is_empty() {
+            control.drop_composing(&mut system.input_method());
+        }
+    });
+    if deleted.is_none() {
+        return Ok(M_E_ERROR);
+    }
+    request_repaint(context);
+
+    Ok(0)
+}
