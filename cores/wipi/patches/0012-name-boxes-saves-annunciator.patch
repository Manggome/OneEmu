+/// `MC_uicGetText(control, position, buffer, size)`: copies the text as shown from character `position`, whole
+/// characters up to `size` - 1 bytes, NUL-terminated, and answers the byte count. It must not be an error code
+/// (리얼사커매니저2009 copies that many bytes out of the buffer), so no control reads as an empty text.
 pub async fn get_text(context: &mut dyn WIPICContext, cc: WIPICWord, position: i32, ptr_buf: WIPICWord, size: i32) -> Result<i32> {
-    tracing::warn!("stub MC_uicGetText({cc:#x}, {position}, {ptr_buf:#x}, {size})");
+    tracing::debug!("MC_uicGetText({cc:#x}, {position}, {ptr_buf:#x}, {size})");
+
+    if ptr_buf == 0 || size <= 0 {
+        return Ok(0);
+    }
+    let text = with_control(context, cc, |control| control.shown_text()).unwrap_or_default();
+
+    let mut bytes = Vec::new();
+    for c in text.chars().skip(position.max(0) as usize) {
+        let mut utf8 = [0; 4];
+        let encoded = encoding_rs::EUC_KR.encode(c.encode_utf8(&mut utf8)).0;
+        if bytes.len() + encoded.len() > size as usize - 1 {
+            break;
+        }
+        bytes.extend_from_slice(&encoded);
+    }
+    context.write_bytes(ptr_buf, &bytes)?;
+    context.write_bytes(ptr_buf + bytes.len() as u32, &[0])?;
+
+    Ok(bytes.len() as i32)
+}
