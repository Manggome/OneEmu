+/// `MC_uicSetMaxTextSize(control, size)`: in bytes of the handset encoding; games size their copy buffers with it.
+pub async fn set_max_text_size(context: &mut dyn WIPICContext, cc: WIPICWord, size: i32) -> Result<i32> {
+    tracing::debug!("MC_uicSetMaxTextSize({cc:#x}, {size})");
+
+    let set = with_control(context, cc, |control| {
+        control.max_size = usize::try_from(size).ok();
+        while !control.fits(TextComponent::size(control.text.iter().copied())) {
+            control.text.pop();
+        }
+        control.cursor = control.cursor.min(control.text.len());
+    });
+
+    Ok(if set.is_some() { 0 } else { M_E_ERROR })
+}
