+/// answer for the buffer it passes to MC_uicGetText.
+pub async fn get_text_size(context: &mut dyn WIPICContext, cc: WIPICWord) -> Result<i32> {
+    let size = with_control(context, cc, |control| TextComponent::size(control.shown_text().chars()) as i32).unwrap_or(0);
