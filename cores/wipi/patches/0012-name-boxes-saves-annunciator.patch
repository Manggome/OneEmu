+/// Feeds a key to the control: 1 when it used the key, 0 when not, M_E_ERROR without a control.
+pub async fn handle_key(context: &mut dyn WIPICContext, cc: WIPICWord, key: TextKey) -> Result<i32> {
+    tracing::debug!("MC_uicHandleEvent({cc:#x}, {key:?})");
+
+    let system = context.system().clone();
+    let used = system.with_state(|controls: &mut Controls| {
+        let control = controls.0.get_mut(&cc)?;
+        Some(control.press(&mut system.input_method(), key))
+    });
+
+    match used {
+        None => Ok(M_E_ERROR),
+        Some(used) => {
+            if used {
+                request_repaint(context);
+            }
+            Ok(used as i32)
+        }
+    }
+}
