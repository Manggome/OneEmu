+    let top = y + (height - FONT_HEIGHT) / 2;
+
+    let text = [before, composing.clone(), after].concat();
+    primitives::draw_text(context, &framebuffer, &text, left, top, black, inner)?;
+    if !composing.is_empty() {
+        let underline = (top + FONT_HEIGHT).min(y + height - 2);
+        primitives::draw_line(
+            context,
+            &framebuffer,
+            left + composing_x,
+            underline,
+            left + cursor_x - 1,
+            underline,
+            black,
+            inner,
+        )?;
+    }
+    if enabled {
+        primitives::fill_rect(context, &framebuffer, left + cursor_x, top, 1, FONT_HEIGHT as u32, black, inner)?;
+    }
+
+    Ok(0)
+}
