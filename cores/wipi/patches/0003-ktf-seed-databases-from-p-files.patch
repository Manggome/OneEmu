 async fn read_packaged_database(context: &mut dyn WIPICContext, name: &str) -> Result<Option<Vec<u8>>> {
-    // Only databases shipped on the jar classpath count as packaged. P/<name> files on the virtual
-    // filesystem are the app's own files: treating them as databases too (for 데몬헌터's Config.dat)
-    // made open() succeed where games probe with it, and broke 이노티아 연대기2 / 미니게임천국4.
-    if context.get_resource_size(name).await?.is_none() {
-        return Ok(None);
+    if context.get_resource_size(name).await?.is_some() {
+        return Ok(Some(context.read_resource(name).await?));
     }
 
-    Ok(Some(context.read_resource(name).await?))
+    // KTF dumps carry the handset's databases as P/<name> files (mounted on the virtual filesystem
+    // with P/ trimmed): 리듬스타's musicdata.dat is the single record of its song database.
+    let filesystem = context.system().filesystem();
+    if !filesystem.exists(name).await {
+        return Ok(None);
+    }
+    let mut data = Vec::new();
+    let mut buf = [0u8; 4096];
+    while let Some(read) = filesystem.read(name, data.len(), buf.len(), &mut buf).await {
+        data.extend_from_slice(&buf[..read]);
+        if read < buf.len() {
+            break;
+        }
+    }
+    Ok(Some(data))
 }
 
