@@ -0,0 +1,33 @@
+use wie_util::{Result, read_null_terminated_string_bytes};
+
+use wipi_types::wipic::WIPICWord;
+
+use crate::context::WIPICContext;
+
+/// Places a voice call to the NUL-terminated number. Games reach it from their customer-support screen ("게임문의 ->
+/// 전화를 거시겠습니까? -> 예") with the publisher's number and treat any non-zero result as "전화를 걸 수 없습니다";
+/// an emulator cannot place calls, so it fails with M_E_ERROR.
+pub async fn call(context: &mut dyn WIPICContext, ptr_number: WIPICWord) -> Result<i32> {
+    let number = read_null_terminated_string_bytes(context, ptr_number)?;
+    tracing::warn!("cannot place a call to {:?}", alloc::string::String::from_utf8_lossy(&number));
+
+    Ok(-1) // M_E_ERROR
+}
+
+#[cfg(test)]
+mod tests {
+    use wie_util::ByteWrite;
+
+    use crate::context::test::TestContext;
+
+    use super::call;
+
+    #[futures_test::test]
+    async fn call_fails_without_stopping_the_game() {
+        let mut context = TestContext::new();
+        // 영웅서기 5 (LGT) copies its support number into a 10-byte stack buffer and passes that.
+        context.write_bytes(0x1000, b"025598787\0").unwrap();
+
+        assert_eq!(call(&mut context, 0x1000).await.unwrap(), -1);
+    }
+}
