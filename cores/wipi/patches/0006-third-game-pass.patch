--- /dev/null
+++ b/wie-wipi-c/src/api/record_database.rs
@@ -0,0 +1,268 @@
+//! The WIPI-C record database (`MC_db*`): named databases of fixed-size records addressed by
+//! record id. KTF exposes it as its own WIPI-C table next to the file-style API in `database.rs`.
+//!
+//! Records live in the platform database repository under the database name; the handle returned to
+//! the application is a guest-heap struct carrying the name and the record size given at open time.
+
+use alloc::{borrow::ToOwned, boxed::Box, string::String, vec, vec::Vec};
+use core::mem::size_of;
+
+use bytemuck::{Pod, Zeroable};
+
+use wipi_types::wipic::WIPICWord;
+
+use wie_backend::Database;
+use wie_util::{Result, read_generic, read_null_terminated_string_bytes, write_generic};
+
+use crate::context::WIPICContext;
+
+#[derive(Pod, Zeroable, Copy, Clone)]
+#[repr(C)]
+struct RecordDatabaseHandle {
+    magic: u32,
+    record_size: u32,
+    name: [u8; 32],
+}
+
+// "MCRD"
+const RECORD_DATABASE_HANDLE_MAGIC: u32 = 0x4D435244;
+const MAX_NAME_LEN: usize = 31;
+
+const M_E_NOENT: i32 = -12;
+const M_E_INVALID: i32 = -22;
+const M_E_INVALIDHANDLE: i32 = -25;
+
+/// `MC_dbOpenDataBase(name, recordSize, create, mode)`. 겟앰프드 opens its "/ga/tm" database as
+/// `(name, 328, 1, 1)` (client.bin 0x1092a4) and keeps the returned id while it is positive.
+pub async fn open_record_database(context: &mut dyn WIPICContext, ptr_name: WIPICWord, record_size: i32, create: i32, mode: i32) -> Result<i32> {
+    let Ok(name) = String::from_utf8(read_null_terminated_string_bytes(context, ptr_name)?) else {
+        return Ok(M_E_INVALID);
+    };
+    tracing::debug!("MC_dbOpenDataBase({name:?}, {record_size}, {create}, {mode})");
+    if name.is_empty() || name.len() > MAX_NAME_LEN || record_size <= 0 {
+        return Ok(M_E_INVALID);
+    }
+
+    {
+        let system = context.system();
+        let pid = system.pid().to_owned();
+        if !system.platform().database_repository().exists(&name, &pid).await {
+            if create == 0 {
+                return Ok(M_E_NOENT);
+            }
+            system.platform().database_repository().open(&name, &pid).await;
+        }
+    }
+
+    let mut handle = RecordDatabaseHandle {
+        magic: RECORD_DATABASE_HANDLE_MAGIC,
+        record_size: record_size as u32,
+        name: [0; 32],
+    };
+    handle.name[..name.len()].copy_from_slice(name.as_bytes());
+
+    let ptr_handle = context.alloc_raw(size_of::<RecordDatabaseHandle>() as _)?;
+    write_generic(context, ptr_handle, handle)?;
+
+    Ok(ptr_handle as _)
+}
+
+/// `MC_dbCloseDataBase(dbId)`. Records are written through on insert/update, so closing only frees the handle.
+pub async fn close_record_database(context: &mut dyn WIPICContext, db_id: i32) -> Result<i32> {
+    tracing::debug!("MC_dbCloseDataBase({db_id:#x})");
+
+    if load_handle(context, db_id)?.is_none() {
+        return Ok(M_E_INVALIDHANDLE);
+    }
+    context.free_raw(db_id as _, size_of::<RecordDatabaseHandle>() as _)?;
+
+    Ok(0)
+}
+
+/// `MC_dbInsertRecord(dbId, buf, len)`: stores a new record and returns its id (ids start at 1).
+pub async fn insert_record(context: &mut dyn WIPICContext, db_id: i32, buf_ptr: WIPICWord, buf_len: i32) -> Result<i32> {
+    tracing::debug!("MC_dbInsertRecord({db_id:#x}, {buf_ptr:#x}, {buf_len})");
+
+    let Some(handle) = load_handle(context, db_id)? else {
+        return Ok(M_E_INVALIDHANDLE);
+    };
+    let Some(data) = read_record_data(context, &handle, buf_ptr, buf_len)? else {
+        return Ok(M_E_INVALID);
+    };
+    let mut db = open_database(context, &handle).await;
+
+    Ok(db.add(&data).await as i32)
+}
+
+/// `MC_dbSelectRecord(dbId, recId, buf, len)`: copies the record (up to `len` bytes) into `buf`.
+pub async fn select_record(context: &mut dyn WIPICContext, db_id: i32, rec_id: i32, buf_ptr: WIPICWord, buf_len: i32) -> Result<i32> {
+    tracing::debug!("MC_dbSelectRecord({db_id:#x}, {rec_id}, {buf_ptr:#x}, {buf_len})");
+
+    let Some(handle) = load_handle(context, db_id)? else {
+        return Ok(M_E_INVALIDHANDLE);
+    };
+    if rec_id <= 0 || buf_len < 0 {
+        return Ok(M_E_INVALID);
+    }
+    let db = open_database(context, &handle).await;
+    let Some(data) = db.get(rec_id as u32).await else {
+        return Ok(M_E_INVALID);
+    };
+
+    let len = data.len().min(buf_len as usize);
+    context.write_bytes(buf_ptr, &data[..len])?;
+
+    Ok(0)
+}
+
+/// `MC_dbUpdateRecord(dbId, recId, buf, len)`: replaces an existing record; 0 on success
+/// (겟앰프드 treats any other value as a failed save, client.bin 0x1091a2).
+pub async fn update_record(context: &mut dyn WIPICContext, db_id: i32, rec_id: i32, buf_ptr: WIPICWord, buf_len: i32) -> Result<i32> {
+    tracing::debug!("MC_dbUpdateRecord({db_id:#x}, {rec_id}, {buf_ptr:#x}, {buf_len})");
+
+    let Some(handle) = load_handle(context, db_id)? else {
+        return Ok(M_E_INVALIDHANDLE);
+    };
+    if rec_id <= 0 {
+        return Ok(M_E_INVALID);
+    }
+    let Some(data) = read_record_data(context, &handle, buf_ptr, buf_len)? else {
+        return Ok(M_E_INVALID);
+    };
+    let mut db = open_database(context, &handle).await;
+    if db.get(rec_id as u32).await.is_none() {
+        return Ok(M_E_INVALID);
+    }
+
+    Ok(if db.set(rec_id as u32, &data).await { 0 } else { M_E_INVALID })
+}
+
+/// Slot 8: `(dbId, idBuf, idCount, comparator, filter)` — writes the ids of the records accepted by
+/// `filter(record)` into `idBuf` (at most `idCount` words) and returns how many were written.
+///
+/// 겟앰프드 passes a 20-word buffer, a null comparator and a filter that copies the record and
+/// returns whether one of its fields is positive (client.bin 0x1090a0); an empty result makes it
+/// insert a new record, otherwise it updates the first id. A null filter accepts every record.
+/// Ordering with a comparator has not been seen in a game yet: ids are kept in ascending order.
+pub async fn list_filtered_records(
+    context: &mut dyn WIPICContext,
+    db_id: i32,
+    ids_ptr: WIPICWord,
+    ids_len: i32,
+    comparator: WIPICWord,
+    filter: WIPICWord,
+) -> Result<i32> {
+    tracing::debug!("MC_dbSortRecords({db_id:#x}, {ids_ptr:#x}, {ids_len}, {comparator:#x}, {filter:#x})");
+
+    let Some(handle) = load_handle(context, db_id)? else {
+        return Ok(M_E_INVALIDHANDLE);
+    };
+    if comparator != 0 {
+        tracing::warn!("MC_dbSortRecords: comparator {comparator:#x} not applied");
+    }
+
+    let db = open_database(context, &handle).await;
+    let mut ids = Vec::new();
+    let record_ptr = if filter != 0 { context.alloc_raw(handle.record_size)? } else { 0 };
+    for id in db.get_record_ids().await {
+        if ids.len() >= ids_len.max(0) as usize {
+            break;
+        }
+        if filter != 0 {
+            let Some(data) = db.get(id).await else {
+                continue;
+            };
+            let mut record = vec![0; handle.record_size as usize];
+            let len = data.len().min(record.len());
+            record[..len].copy_from_slice(&data[..len]);
+            context.write_bytes(record_ptr, &record)?;
+            if context.call_function(filter, &[record_ptr]).await? == 0 {
+                continue;
+            }
+        }
+        ids.push(id);
+    }
+    if record_ptr != 0 {
+        context.free_raw(record_ptr, handle.record_size)?;
+    }
+
+    for (index, id) in ids.iter().enumerate() {
+        write_generic(context, ids_ptr + (index * size_of::<u32>()) as u32, *id)?;
+    }
+
+    Ok(ids.len() as i32)
+}
+
+fn load_handle(context: &mut dyn WIPICContext, db_id: i32) -> Result<Option<RecordDatabaseHandle>> {
+    if db_id < 0x10000 {
+        return Ok(None);
+    }
+    let handle: RecordDatabaseHandle = read_generic(context, db_id as _)?;
+
+    Ok((handle.magic == RECORD_DATABASE_HANDLE_MAGIC).then_some(handle))
+}
+
+/// Reads a record from the guest as exactly `record_size` bytes (a shorter buffer is zero-padded).
+fn read_record_data(context: &mut dyn WIPICContext, handle: &RecordDatabaseHandle, buf_ptr: WIPICWord, buf_len: i32) -> Result<Option<Vec<u8>>> {
+    if buf_len < 0 || buf_len as u32 > handle.record_size {
+        return Ok(None);
+    }
+    let mut data = vec![0; handle.record_size as usize];
+    context.read_bytes(buf_ptr, &mut data[..buf_len as usize])?;
+
+    Ok(Some(data))
+}
+
+async fn open_database(context: &mut dyn WIPICContext, handle: &RecordDatabaseHandle) -> Box<dyn Database> {
+    let length = handle.name.iter().position(|&c| c == 0).unwrap_or(handle.name.len());
+    let name = String::from_utf8_lossy(&handle.name[..length]).into_owned();
+
+    let system = context.system();
+    let pid = system.pid().to_owned();
+
+    system.platform().database_repository().open(&name, &pid).await
+}
+
+#[cfg(test)]
+mod tests {
+    use alloc::boxed::Box;
+
+    use test_utils::TestPlatform;
+    use wie_backend::{DefaultTaskRunner, System};
+    use wie_util::{ByteRead, ByteWrite};
+
+    use crate::context::test::TestContext;
+
+    use super::{close_record_database, insert_record, list_filtered_records, open_record_database, select_record, update_record};
+
+    #[futures_test::test]
+    async fn records_round_trip_by_id() {
+        let system = System::new(Box::new(TestPlatform::new()), "test-pid", "test-aid", DefaultTaskRunner);
+        let mut context = TestContext::with_system(system);
+        context.write_bytes(0x1000, b"/ga/tm\0").unwrap();
+
+        assert_eq!(open_record_database(&mut context, 0x1000, 8, 0, 1).await.unwrap(), -12);
+        let db_id = open_record_database(&mut context, 0x1000, 8, 1, 1).await.unwrap();
+        assert!(db_id > 0);
+        assert_eq!(list_filtered_records(&mut context, db_id, 0x3000, 20, 0, 0).await.unwrap(), 0);
+
+        context.write_bytes(0x2000, &[1, 2, 3, 4, 5, 6, 7, 8]).unwrap();
+        assert_eq!(insert_record(&mut context, db_id, 0x2000, 4).await.unwrap(), 1);
+        assert_eq!(insert_record(&mut context, db_id, 0x2000, 9).await.unwrap(), -22);
+        assert_eq!(update_record(&mut context, db_id, 1, 0x2004, 4).await.unwrap(), 0);
+        assert_eq!(update_record(&mut context, db_id, 2, 0x2000, 8).await.unwrap(), -22);
+
+        assert_eq!(select_record(&mut context, db_id, 1, 0x2100, 8).await.unwrap(), 0);
+        let mut data = [0; 8];
+        context.read_bytes(0x2100, &mut data).unwrap();
+        assert_eq!(data, [5, 6, 7, 8, 0, 0, 0, 0]);
+
+        assert_eq!(list_filtered_records(&mut context, db_id, 0x3000, 20, 0, 0).await.unwrap(), 1);
+        let mut id = [0; 4];
+        context.read_bytes(0x3000, &mut id).unwrap();
+        assert_eq!(u32::from_le_bytes(id), 1);
+
+        assert_eq!(close_record_database(&mut context, db_id).await.unwrap(), 0);
+        assert!(open_record_database(&mut context, 0x1000, 8, 0, 1).await.unwrap() > 0);
+    }
+}
