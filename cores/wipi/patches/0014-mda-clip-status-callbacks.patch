+        async fn call(&self, context: &mut dyn WIPICContext, _: Box<[WIPICWord]>) -> Result<WIPICResult> {
+            let current = context
+                .system()
+                .with_state(|clips: &mut ClipCallbacks| clips.clips.get(&self.clip).map(|entry| entry.generation));
+            if current == Some(self.generation) {
+                tracing::debug!("MC_mda clip {:#x} callback {:#x}(status {})", self.clip, self.callback, self.status);
+                context.call_function(self.callback, &[self.clip, self.status as _]).await?;
+            }
