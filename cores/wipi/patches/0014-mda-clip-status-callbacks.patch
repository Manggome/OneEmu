+
+impl ClipCallbacks {
+    /// Starts a new generation of `clip`, optionally changing whether it is active.
+    fn renew(&mut self, clip: WIPICWord, active: Option<bool>) -> Option<(WIPICWord, u64)> {
+        let entry = self.clips.get_mut(&clip)?;
+        self.last_generation += 1;
+        entry.generation = self.last_generation;
+        if let Some(active) = active {
+            entry.active = active;
+        }
+
+        Some((entry.callback, entry.generation))
+    }
