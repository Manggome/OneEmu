+    /// SMAF with one ADPCM audio track (mono, 8 kHz, 4 bit) that plays a wave of `wave_len` bytes at time 0:
+    /// `wave_len` / 4 ms long.
+    fn adpcm_smaf(wave_len: usize) -> Vec<u8> {
+        let sequence = [0x00, 0x01, 0x01, 0x00, 0x00, 0x00, 0x00];
+        let mut track = vec![0x00, 0x00, 0x11, 0x00, 0x02, 0x02];
+        track.extend_from_slice(b"Atsq");
+        track.extend_from_slice(&(sequence.len() as u32).to_be_bytes());
+        track.extend_from_slice(&sequence);
+        track.extend_from_slice(b"Awa\x01");
+        track.extend_from_slice(&(wave_len as u32).to_be_bytes());
+        track.extend(core::iter::repeat_n(0x11, wave_len));
+
+        let mut body = b"ATR\x00".to_vec();
+        body.extend_from_slice(&(track.len() as u32).to_be_bytes());
+        body.extend_from_slice(&track);
+        let mut file = b"MMMD".to_vec();
+        file.extend_from_slice(&(body.len() as u32 + 2).to_be_bytes());
+        file.extend_from_slice(&body);
+        file.extend_from_slice(&[0, 0]);
+        file
+    }
