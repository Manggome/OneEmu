+/// The callbacks of the live clips that have one, by clip address.
+///
+/// Sound managers run on these: Gamevil's (하이브리드 1/2, 제노니아, 2010프로야구) keeps one clip and makes the
+/// next one only after the callback reported that the last one ended or stopped and the game freed it there.
+/// Without the reports such a game plays its first sound and nothing after it.
+#[derive(Default)]
+struct ClipCallbacks {
+    clips: BTreeMap<WIPICWord, ClipCallback>,
+    last_generation: u64,
+}
+
+struct ClipCallback {
+    callback: WIPICWord,
+    /// Renewed on every change of the clip's playback (play, stop, new data) and for every clip made: a report
+    /// queued for an earlier playback, or for a freed clip, is dropped instead of reaching the game late.
+    generation: u64,
+    /// Played since it was last stopped, also after it reached its end: stopping it reports STOPP (하이브리드 stops
+    /// its clip from the END_OF_DATA callback and frees it on the STOPP that follows).
+    active: bool,
