+fn sequence_length(sequence: &AudioSequence) -> u64 {
+    sequence
+        .events
+        .iter()
+        .map(|event| match &event.data {
+            AudioEventData::Wave {
+                channels,
+                sampling_rate,
+                samples,
+            } if *channels > 0 && *sampling_rate > 0 => {
+                let frames = (samples.len() / *channels as usize) as u64;
+                event.time + (frames * 1000).div_ceil(*sampling_rate as u64)
+            }
+            _ => event.time,
+        })
+        .fold(sequence.duration, u64::max)
+}
