+/// The app's private record listing the dump's `P/` files it has removed, one name per line.
+const REMOVED_PACKAGED_FILES: &str = ".wie-removed";
+
+async fn removed_packaged_files(context: &mut dyn WIPICContext) -> Vec<u8> {
+    let system = context.system();
+    let pid = system.pid().to_owned();
+    if !system.platform().database_repository().exists(REMOVED_PACKAGED_FILES, &pid).await {
+        return Vec::new();
+    }
+
+    let db = system.platform().database_repository().open(REMOVED_PACKAGED_FILES, &pid).await;
+    db.get(1).await.unwrap_or_default()
+}
+
+async fn packaged_file_removed(context: &mut dyn WIPICContext, name: &str) -> bool {
+    removed_packaged_files(context)
+        .await
+        .split(|&b| b == b'\n')
+        .any(|removed| removed == name.as_bytes())
+}
+
+async fn mark_packaged_file_removed(context: &mut dyn WIPICContext, name: &str) {
+    let mut list = removed_packaged_files(context).await;
+    list.extend_from_slice(name.as_bytes());
+    list.push(b'\n');
+
+    let system = context.system();
+    let pid = system.pid().to_owned();
+    let mut db = system.platform().database_repository().open(REMOVED_PACKAGED_FILES, &pid).await;
+    db.set(1, &list).await;
 }
 
