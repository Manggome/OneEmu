+/// KTF `remove(name, mode)`: deletes the app's file `name`; 0 on success, `M_E_NOENT` when there was none.
+///
+/// A file the dump carries as `P/<name>` is part of the app's storage too, so removing it must hide that
+/// copy from later opens: 이노티아 연대기2 removes a certificate that fails its check (cert.c2s bound to
+/// another app and handset) before showing error 3001 and quitting, and on the next start it finds no
+/// certificate and runs its own "no certificate" path. With the copy left in place the game showed 3001 on
+/// every start. Packaged jar resources are read-only and stay visible.
+async fn remove_file_ktf(context: &mut dyn WIPICContext, ptr_name: WIPICWord, mode: i32) -> Result<i32> {
+    let Ok(name) = String::from_utf8(read_null_terminated_string_bytes(context, ptr_name)?) else {
+        return Ok(-22);
+    };
+    if name.is_empty() || name.len() > MAX_NAME_LEN {
+        return Ok(-22);
+    }
+
+    let system = context.system();
+    let pid = system.pid().to_owned();
+    let deleted = system.platform().database_repository().delete(&name, &pid).await;
+    let packaged = !packaged_file_removed(context, &name).await && context.system().filesystem().exists(&name).await;
+    if packaged {
+        mark_packaged_file_removed(context, &name).await;
+    }
+
+    let result = if deleted || packaged { 0 } else { -12 }; // M_E_NOENT
+    tracing::debug!("remove({name:?}, {mode}) -> {result}");
+    Ok(result)
+}
