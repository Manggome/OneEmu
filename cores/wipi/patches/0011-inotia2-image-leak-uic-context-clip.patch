+/// `MC_GrpContext.mask` bit of a field index: set by `MC_grpSetContext`, so only fields a game set apply.
+const fn context_bit(index: WIPICGraphicsContextIdx) -> u32 {
+    1 << (index as u32)
+}
+
+/// Narrows a draw call's own clip to the graphics context's clip (`MC_GRP_CONTEXT_CLIP_IDX`, {x1, y1, x2, y2}
+/// with x2/y2 exclusive, as LGT's platform reads it) when the game set one. Games draw one glyph out of a
+/// sprite strip this way: 메이플스토리 도적편 draws its whole 320 px digit strip for every digit.
+fn with_context_clip(gctx: Option<&WIPICGraphicsContext>, clip: Clip) -> Clip {
+    match gctx {
+        Some(gctx) if gctx.mask & context_bit(WIPICGraphicsContextIdx::ClipIdx) != 0 => {
+            let [x1, y1, x2, y2] = gctx.clip.map(|value| i32::from(value as i16));
+            clip.intersect(&Clip {
+                x: x1,
+                y: y1,
+                width: (x2 - x1).max(0) as u32,
+                height: (y2 - y1).max(0) as u32,
+            })
+        }
+        _ => clip,
+    }
+}
+
+fn read_context(context: &dyn WIPICContext, p_gctx: WIPICWord) -> Result<Option<WIPICGraphicsContext>> {
+    Ok(if p_gctx == 0 { None } else { Some(read_generic(context, p_gctx)?) })
+}
