+        assert_eq!(call(&table, 2, &[0, 0], &mut memory).await, 0); // MC_uicCreate: no control
+        for (slot, args) in [(9, &[0, 70, 100, 100, 18, 3][..]), (33, &[0, 0, u32::MAX]), (35, &[0, 10]), (11, &[0, 1])] {
+            assert_eq!(call(&table, slot, args, &mut memory).await, u32::MAX, "slot {slot}"); // M_E_ERROR
