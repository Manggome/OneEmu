+/// `MC_grpDestroyImage`: frees the image and the pixels MC_grpCreateImage decoded into it. Freeing only the
+/// image record leaked every decoded picture: 겟앰프드 loads its stage sprites again for every fight and ran
+/// out of heap ("Allocation failure") after about three minutes of play.
 pub async fn destroy_image(context: &mut dyn WIPICContext, image: WIPICIndirectPtr) -> Result<()> {
     tracing::debug!("MC_grpDestroyImage({:#x})", image.0);
 
+    if image.0 == 0 {
+        return Ok(());
+    }
+
+    let ptr_data = context.data_ptr(image)?;
+    let mut data: WIPICImage = read_generic(context, ptr_data)?;
+    free_framebuffer_pixels(context, &mut data.img)?;
+    free_framebuffer_pixels(context, &mut data.mask)?;
+    write_generic(context, ptr_data, data)?;
+
     context.free(image)?;
 
     Ok(())
 }
 
+/// Frees a framebuffer's pixel buffer and clears the pointer, so destroying the same record twice (a game bug
+/// handsets survive) does not free the pixels again.
+fn free_framebuffer_pixels(context: &mut dyn WIPICContext, framebuffer: &mut WIPICFramebuffer) -> Result<()> {
+    if framebuffer.buf.0 != 0 {
+        context.free(framebuffer.buf)?;
+        framebuffer.buf = WIPICIndirectPtr(0);
+    }
+
+    Ok(())
+}
