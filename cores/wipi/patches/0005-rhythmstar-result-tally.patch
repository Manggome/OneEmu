diff --git a/wie-core-arm/data/binary_patches.toml b/wie-core-arm/data/binary_patches.toml
index ddd2fae2..7a3afe26 100644
--- a/wie-core-arm/data/binary_patches.toml
+++ b/wie-core-arm/data/binary_patches.toml
@@ -4,7 +4,9 @@
 #   - hash-keyed: `hash` is the MD5 of the main guest binary (KTF
 #     `client.bin`, LGT `binary.mod`, etc.). Matched and installed on boot.
 #   - pattern-only (hash omitted): generic patterns that apply to any binary
-#     matching the bytes. Hash-keyed entries take priority.
+#     matching the bytes. The generic entry is installed first, then the
+#     hash-keyed entry of the binary (if any) on top of it. Only one of the
+#     two may install hooks for a binary (the hook SVC handler is registered once).
 #
 # Hook `pc`/`exit_pc` MUST have the Thumb bit (LSB=1); ARM-mode hooks are
 # not supported. Stack offsets are signed and measured from R7 (Thumb
@@ -98,3 +100,18 @@ pattern = "70 b5 0b 1c 03 43 03 22 13 40 04 1c"
 [[entry.hook]]
 kind = "strlen"
 pattern = "30 b5 03 23 03 40 04 1c 00 2b"
+
+[[entry]]
+name = "리듬스타 (KTF 010100D2): at most 60 distinct song packs in the result tally"
+hash = "53870d41fc56d30bf082eb96537ebb15"
+
+# After a song the result screen tallies the distinct song packs (`.pak` names) of the song list into a
+# 60-slot stack array (client.bin 0x113e04: memset(sp + 0x34, 0, 60 * 0x80)) without a bound check. With
+# more than 60 packs (the wipiX dump carries 94, the merged song list 109) the copies run over the frame
+# and the callers' saved registers, and the timer callback crashes on a string read as a pointer.
+# Skip new packs once the array is full: `cmp count, #0; bgt dedup; b ...` becomes
+# `cmp count, #60; bge next_song; nop` (the dedup loop is also correct for an empty array: slot 0 is zeroed).
+[[entry.patch]]
+pc = 0x113fa0
+bytes = "3c 28 19 da c0 46"
+expect = "00 28 00 dc 2f e1"
