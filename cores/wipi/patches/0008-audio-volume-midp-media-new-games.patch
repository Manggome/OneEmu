+//! Standard MIDI File (SMF format 0/1/2) to a timed MIDI event sequence in milliseconds.
+
+use alloc::{vec, vec::Vec};
+
+use crate::{AudioEventData, AudioSequence, TimedAudioEvent};
+
+const DEFAULT_TEMPO: u64 = 500_000; // microseconds per quarter note (120 bpm)
+
+enum TrackEvent {
+    Midi(Vec<u8>),
+    Tempo(u64),
+    End,
+}
+
+struct Reader<'a> {
+    data: &'a [u8],
+    pos: usize,
+}
+
+impl Reader<'_> {
+    fn u8(&mut self) -> Option<u8> {
+        let value = *self.data.get(self.pos)?;
+        self.pos += 1;
+        Some(value)
+    }
+
+    fn bytes(&mut self, length: usize) -> Option<&[u8]> {
+        let end = self.pos.checked_add(length)?;
+        let value = self.data.get(self.pos..end)?;
+        self.pos = end;
+        Some(value)
+    }
+
+    fn vlq(&mut self) -> Option<u64> {
+        let mut value = 0u64;
+        for _ in 0..4 {
+            let byte = self.u8()?;
+            value = (value << 7) | (byte & 0x7f) as u64;
+            if byte & 0x80 == 0 {
+                return Some(value);
+            }
+        }
+        None
+    }
+}
+
+fn be32(data: &[u8], at: usize) -> Option<usize> {
+    Some(u32::from_be_bytes(data.get(at..at + 4)?.try_into().ok()?) as usize)
+}
+
+/// Events of one MTrk chunk as (tick, event). A malformed tail ends the track at the last good event.
+fn parse_track(data: &[u8]) -> Vec<(u64, TrackEvent)> {
+    let mut reader = Reader { data, pos: 0 };
+    let mut events = Vec::new();
+    let mut tick = 0u64;
+    let mut running_status = None;
+
+    while let Some(delta) = reader.vlq() {
+        tick += delta;
+        let Some(first) = reader.u8() else { break };
+        let status = if first & 0x80 != 0 {
+            first
+        } else {
+            // Running status: `first` is already the first data byte.
+            reader.pos -= 1;
+            match running_status {
+                Some(status) => status,
+                None => break,
+            }
+        };
+
+        match status {
+            0xff => {
+                running_status = None;
+                let (Some(kind), Some(length)) = (reader.u8(), reader.vlq()) else {
+                    break;
+                };
+                let Some(body) = reader.bytes(length as usize) else { break };
+                match kind {
+                    0x51 if body.len() == 3 => events.push((
+                        tick,
+                        TrackEvent::Tempo(((body[0] as u64) << 16) | ((body[1] as u64) << 8) | body[2] as u64),
+                    )),
+                    0x2f => {
+                        events.push((tick, TrackEvent::End));
+                        break;
+                    }
+                    _ => {}
+                }
+            }
+            0xf0 | 0xf7 => {
+                running_status = None;
+                let Some(length) = reader.vlq() else { break };
+                let Some(body) = reader.bytes(length as usize) else { break };
+                if status == 0xf0 {
+                    let mut message = vec![0xf0];
+                    message.extend_from_slice(body);
+                    events.push((tick, TrackEvent::Midi(message)));
+                }
+            }
+            0x80..=0xef => {
+                running_status = Some(status);
+                let length = if matches!(status & 0xf0, 0xc0 | 0xd0) { 1 } else { 2 };
+                let Some(body) = reader.bytes(length) else { break };
+                let mut message = vec![status];
+                message.extend_from_slice(body);
+                events.push((tick, TrackEvent::Midi(message)));
+            }
+            _ => break,
+        }
+    }
+
+    events
+}
+
+pub fn parse_midi(data: &[u8]) -> Option<AudioSequence> {
+    if data.get(0..4)? != b"MThd" {
+        return None;
+    }
+    let header_length = be32(data, 4)?;
+    let header = data.get(8..8 + header_length.max(6))?;
+    let division = u16::from_be_bytes([header[4], header[5]]);
+
+    // (tick, track, event): a stable sort by tick keeps each track's order and puts earlier tracks first.
+    let mut events = Vec::new();
+    let mut pos = 8 + header_length;
+    let mut track = 0;
+    while pos + 8 <= data.len() {
+        let length = be32(data, pos + 4)?;
+        let body = &data[pos + 8..(pos + 8).saturating_add(length).min(data.len())];
+        if &data[pos..pos + 4] == b"MTrk" {
+            events.extend(parse_track(body).into_iter().map(|(tick, event)| (tick, track, event)));
+            track += 1;
+        }
+        pos = pos.saturating_add(8 + length);
+    }
+    events.sort_by_key(|(tick, track, _)| (*tick, *track));
+
+    // Ticks to microseconds: SMPTE divisions are fixed ticks per second, PPQ divisions follow the tempo map.
+    let smpte_ticks_per_second = if division & 0x8000 != 0 {
+        let frames = -((division >> 8) as i8) as u64;
+        Some((frames * (division & 0xff) as u64).max(1))
+    } else {
+        None
+    };
+    let ticks_per_quarter = (division as u64).max(1);
+    let (mut tempo, mut last_tick, mut last_us) = (DEFAULT_TEMPO, 0u64, 0u64);
+
+    let mut sequence = AudioSequence {
+        duration: 0,
+        events: Vec::new(),
+    };
+    for (tick, _, event) in events {
+        let us = match smpte_ticks_per_second {
+            Some(ticks_per_second) => tick * 1_000_000 / ticks_per_second,
+            None => last_us + (tick - last_tick) * tempo / ticks_per_quarter,
+        };
+        (last_tick, last_us) = (tick, us);
+        let time = us / 1000;
+        sequence.duration = sequence.duration.max(time);
+
+        match event {
+            TrackEvent::Midi(message) => sequence.events.push(TimedAudioEvent {
+                time,
+                data: AudioEventData::Midi(message),
+            }),
+            TrackEvent::Tempo(value) => tempo = value,
+            TrackEvent::End => {}
+        }
+    }
+
+    Some(sequence)
+}
+
+#[cfg(test)]
+mod tests {
+    use alloc::vec;
+
+    use super::parse_midi;
+    use crate::{AudioEventData, TimedAudioEvent};
+
+    #[test]
+    fn parses_tempo_running_status_and_tracks() {
+        let mut data = vec![];
+        data.extend_from_slice(b"MThd\0\0\0\x06\0\x01\0\x02\x00\x60"); // format 1, 2 tracks, 96 ppq
+        // tempo track: 250000 us per quarter (240 bpm) at tick 0, end at 96
+        let track0 = [0x00, 0xff, 0x51, 0x03, 0x03, 0xd0, 0x90, 0x60, 0xff, 0x2f, 0x00];
+        data.extend_from_slice(b"MTrk\0\0\0\x0b");
+        data.extend_from_slice(&track0);
+        // note on, running-status note on after a quarter, program change, end
+        let track1 = [0x00, 0x90, 0x3c, 0x40, 0x60, 0x3e, 0x40, 0x00, 0xc1, 0x05, 0x00, 0xff, 0x2f, 0x00];
+        data.extend_from_slice(b"MTrk\0\0\0\x0e");
+        data.extend_from_slice(&track1);
+
+        let sequence = parse_midi(&data).unwrap();
+        assert_eq!(
+            sequence.events,
+            vec![
+                TimedAudioEvent {
+                    time: 0,
+                    data: AudioEventData::Midi(vec![0x90, 0x3c, 0x40])
+                },
+                TimedAudioEvent {
+                    time: 250,
+                    data: AudioEventData::Midi(vec![0x90, 0x3e, 0x40])
+                },
+                TimedAudioEvent {
+                    time: 250,
+                    data: AudioEventData::Midi(vec![0xc1, 0x05])
+                },
+            ]
+        );
+        assert_eq!(sequence.duration, 250);
+    }
+
+    #[test]
+    fn rejects_other_data() {
+        assert!(parse_midi(b"MMMD").is_none());
+    }
+}
