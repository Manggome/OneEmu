+//! RIFF WAVE with linear PCM (8-bit unsigned or 16-bit signed) to a single PCM event.
+
+use alloc::{vec, vec::Vec};
+
+use crate::{AudioEventData, AudioSequence, TimedAudioEvent};
+
+pub fn parse_wave(data: &[u8]) -> Option<AudioSequence> {
+    if data.get(0..4)? != b"RIFF" || data.get(8..12)? != b"WAVE" {
+        return None;
+    }
+
+    let mut format = None;
+    let mut pos = 12;
+    while pos + 8 <= data.len() {
+        let length = u32::from_le_bytes(data[pos + 4..pos + 8].try_into().ok()?) as usize;
+        let body = &data[pos + 8..(pos + 8).saturating_add(length).min(data.len())];
+        match &data[pos..pos + 4] {
+            b"fmt " if body.len() >= 16 => {
+                let u16_at = |at: usize| u16::from_le_bytes([body[at], body[at + 1]]);
+                let sampling_rate = u32::from_le_bytes(body[4..8].try_into().ok()?);
+                // (format tag, channels, rate, bits per sample)
+                format = Some((u16_at(0), u16_at(2), sampling_rate, u16_at(14)));
+            }
+            b"data" => {
+                let (1, channels @ 1..=2, sampling_rate @ 1.., bits) = format? else {
+                    return None;
+                };
+                let samples: Vec<i16> = match bits {
+                    8 => body.iter().map(|&x| ((x as i16) - 128) << 8).collect(),
+                    16 => body.as_chunks::<2>().0.iter().map(|x| i16::from_le_bytes(*x)).collect(),
+                    _ => return None,
+                };
+                let duration = (samples.len() as u64 / channels as u64) * 1000 / sampling_rate as u64;
+
+                return Some(AudioSequence {
+                    duration,
+                    events: vec![TimedAudioEvent {
+                        time: 0,
+                        data: AudioEventData::Wave {
+                            channels: channels as u8,
+                            sampling_rate,
+                            samples,
+                        },
+                    }],
+                });
+            }
+            _ => {}
+        }
+        // Chunks are padded to an even length.
+        pos = pos.saturating_add(8 + length + (length & 1));
+    }
+
+    None
+}
+
+#[cfg(test)]
+mod tests {
+    use alloc::vec;
+
+    use super::parse_wave;
+    use crate::AudioEventData;
+
+    #[test]
+    fn parses_8bit_mono_pcm() {
+        let mut data = vec![];
+        data.extend_from_slice(b"RIFF\x2c\0\0\0WAVEfmt \x10\0\0\0\x01\0\x01\0\x40\x1f\0\0\x40\x1f\0\0\x01\0\x08\0data\x04\0\0\0");
+        data.extend_from_slice(&[0x80, 0xff, 0x00, 0x90]);
+
+        let sequence = parse_wave(&data).unwrap();
+        let AudioEventData::Wave {
+            channels,
+            sampling_rate,
+            samples,
+        } = &sequence.events[0].data
+        else {
+            panic!("expected PCM");
+        };
+        assert_eq!((*channels, *sampling_rate), (1, 8000));
+        assert_eq!(samples, &vec![0, 127 << 8, -128 << 8, 16 << 8]);
+        assert_eq!(sequence.duration, 0);
+    }
+
+    #[test]
+    fn rejects_compressed_wave() {
+        let data = b"RIFF\x24\0\0\0WAVEfmt \x10\0\0\0\x11\0\x01\0\x40\x1f\0\0\x40\x1f\0\0\x01\0\x04\0data\x00\0\0\0";
+        assert!(parse_wave(data).is_none());
+    }
+}
