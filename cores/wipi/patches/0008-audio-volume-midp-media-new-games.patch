+/// SMAF's 4-bit Yamaha ADPCM keeps the first sample of each byte in the low nibble. smaf-player 0.1.2 decodes
+/// the high nibble first, which turns every sampled sound into a drifting, clipping signal: decoded effects sit
+/// on DC plateaus of up to half full scale and saturate in bursts (슈퍼액션히어로 3: 1194 clipped samples in its
+/// first 40 waves, 132 in low-nibble order; low-nibble order has less DC drift in 47 of its 58 waves and in most
+/// waves of every other game with ADPCM effects). Replace each wave event's samples with the low-nibble
+/// decoding of the wave data they were made from.
+fn redecode_adpcm_waves(data: &[u8], events: &mut [(usize, SmafEvent)]) {
+    if !events.iter().any(|(_, event)| matches!(event, SmafEvent::Wave { .. })) {
+        return;
+    }
+    let Ok(smaf) = Smaf::parse(data) else {
+        return;
+    };
+
+    let mut waves: Vec<&[u8]> = Vec::new();
+    for chunk in &smaf.chunks {
+        match chunk {
+            SmafChunk::ScoreTrack(_, track) => {
+                for chunk in &track.chunks {
+                    if let ScoreTrackChunk::PCMData(pcm) = chunk {
+                        waves.extend(pcm.iter().map(|PCMDataChunk::WaveData(_, wave)| wave.wave_data));
+                    }
+                }
+            }
+            SmafChunk::PCMAudioTrack(_, track) => {
+                for chunk in &track.chunks {
+                    if let PCMAudioTrackChunk::WaveData(_, wave) = chunk {
+                        waves.push(wave);
+                    }
+                }
+            }
+            _ => {}
+        }
+    }
+
+    // (smaf-player's decoding, correct decoding) per wave, made on first use. An event is matched to its wave
+    // by content, so waves smaf-player skips or decodes some other way are left alone.
+    let mut decoded: Vec<Option<(Vec<i16>, Vec<i16>)>> = vec![None; waves.len()];
+    for (_, event) in events.iter_mut() {
+        let SmafEvent::Wave { data: samples, .. } = event else {
+            continue;
+        };
+        for (wave, decoded) in waves.iter().zip(decoded.iter_mut()) {
+            if wave.len() * 2 != samples.len() {
+                continue;
+            }
+            let (high_first, low_first) = decoded.get_or_insert_with(|| (decode_yamaha_adpcm(wave, false), decode_yamaha_adpcm(wave, true)));
+            if high_first == samples {
+                samples.clone_from(low_first);
+                break;
+            }
+        }
+    }
