+#[cfg(test)]
+mod tests {
+    use alloc::boxed::Box;
+
+    use test_utils::TestPlatform;
+    use wie_backend::{DefaultTaskRunner, System};
+    use wie_util::{ByteWrite, Result, read_generic};
+
+    use crate::{WIPICContext, context::test::TestContext};
+
+    use super::{MdaClip, NO_SOUND, clip_create, clip_free, clip_get_volume, clip_put_data, clip_set_volume, get_volume, set_volume};
+
+    fn media_test_context() -> TestContext {
+        TestContext::with_system(System::new(Box::new(TestPlatform::new()), "test-pid", "test-aid", DefaultTaskRunner))
+    }
+
+    #[futures_test::test]
+    async fn clip_volume_follows_the_clip_and_its_sound() -> Result<()> {
+        let mut context = media_test_context();
+        let data = context.alloc_raw(4)?;
+        context.write_bytes(data, &[0; 4])?;
+
+        let clip = clip_create(&mut context, 0, 0x400, 0).await?;
+        assert_eq!(clip_get_volume(&mut context, clip).await?, 100);
+
+        // a volume set before the data reaches the sound made from it
+        clip_set_volume(&mut context, clip, 40).await?;
+        assert_eq!(clip_put_data(&mut context, clip, data, 4).await?, 4);
+        let handle = read_generic::<MdaClip, _>(&context, clip)?.handle;
+        assert_ne!(handle, NO_SOUND);
+        assert_eq!(context.system().audio().volume(handle).unwrap(), 40);
+
+        clip_set_volume(&mut context, clip, 250).await?;
+        assert_eq!(clip_get_volume(&mut context, clip).await?, 100);
+        clip_set_volume(&mut context, clip, -3).await?;
+        assert_eq!(clip_get_volume(&mut context, clip).await?, 0);
+        assert_eq!(context.system().audio().volume(handle).unwrap(), 0);
+
+        assert_eq!(get_volume(&mut context).await?, 100);
+        set_volume(&mut context, 66).await?;
+        assert_eq!(get_volume(&mut context).await?, 66);
+
+        Ok(())
+    }
+
+    #[futures_test::test]
+    async fn clip_free_and_new_data_close_the_previous_sound() -> Result<()> {
+        let mut context = media_test_context();
+        let data = context.alloc_raw(4)?;
+        context.write_bytes(data, &[0; 4])?;
+
+        let clip = clip_create(&mut context, 0, 0x400, 0).await?;
+        clip_put_data(&mut context, clip, data, 4).await?;
+        clip_put_data(&mut context, clip, data, 4).await?;
+        assert_eq!(context.system().audio().loaded_count(), 1);
+
+        clip_free(&mut context, clip).await?;
+        assert_eq!(context.system().audio().loaded_count(), 0);
+
+        // a clip made over a freed one's memory starts without a sound
+        let next = context.alloc_raw(0)?; // the test allocator's next address
+        context.write_bytes(next, &[0x55; size_of::<MdaClip>()])?;
+        let fresh = clip_create(&mut context, 0, 0x400, 0).await?;
+        assert_eq!(fresh, next);
+        assert_eq!(read_generic::<MdaClip, _>(&context, fresh)?.handle, NO_SOUND);
+        clip_free(&mut context, fresh).await?;
+
+        Ok(())
+    }
+}
