+/// 4-bit Yamaha ADPCM (MA-series / ADPCM-B step adaptation), two samples per byte.
+fn decode_yamaha_adpcm(data: &[u8], low_nibble_first: bool) -> Vec<i16> {
+    const STEP_SCALE: [u32; 8] = [57, 57, 57, 57, 77, 102, 128, 153];
+
+    let mut result = Vec::with_capacity(data.len() * 2);
+    let (mut history, mut step) = (0i32, 127u32);
+    for byte in data {
+        let nibbles = if low_nibble_first {
+            [byte & 0x0f, byte >> 4]
+        } else {
+            [byte >> 4, byte & 0x0f]
+        };
+        for nibble in nibbles {
+            let magnitude = (nibble & 7) as u32;
+            let diff = (((1 + (magnitude << 1)) * step) >> 3) as i32;
+            history = if nibble & 8 != 0 { history - diff } else { history + diff }.clamp(i16::MIN as i32, i16::MAX as i32);
+            step = ((STEP_SCALE[magnitude as usize] * step) >> 6).clamp(127, 24576);
+            result.push(history as i16);
+        }
+    }
+
+    result
 }
 
