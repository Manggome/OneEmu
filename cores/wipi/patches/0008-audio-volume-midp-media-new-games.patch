@@ -0,0 +1,83 @@
+use alloc::vec;
+
+use jvm::{ClassInstanceRef, Jvm, Result as JvmResult};
+use jvm_class_proto::{JavaFieldProto, JavaMethodProto};
+use jvm_types::{ClassAccessFlags, FieldAccessFlags, MethodAccessFlags};
+
+use wie_backend::MAX_AUDIO_VOLUME;
+use wie_jvm_support::{WieJavaClassProto, WieJvmContext};
+
+// class net.wie.PlayerVolumeControl: the VolumeControl of a net.wie.SmafPlayer. It keeps level and mute state as
+// MIDP specifies and gives the player's sound that volume (0 while muted).
+pub struct PlayerVolumeControl;
+
+impl PlayerVolumeControl {
+    pub fn as_proto() -> WieJavaClassProto {
+        WieJavaClassProto {
+            name: "net/wie/PlayerVolumeControl",
+            parent_class: Some("java/lang/Object"),
+            interfaces: vec!["javax/microedition/media/control/VolumeControl"],
+            methods: vec![
+                JavaMethodProto::new("<init>", "(I)V", Self::init, MethodAccessFlags::PUBLIC),
+                JavaMethodProto::new("setMute", "(Z)V", Self::set_mute, MethodAccessFlags::PUBLIC),
+                JavaMethodProto::new("isMuted", "()Z", Self::is_muted, MethodAccessFlags::PUBLIC),
+                JavaMethodProto::new("setLevel", "(I)I", Self::set_level, MethodAccessFlags::PUBLIC),
+                JavaMethodProto::new("getLevel", "()I", Self::get_level, MethodAccessFlags::PUBLIC),
+            ],
+            fields: vec![
+                JavaFieldProto::new("level", "I", FieldAccessFlags::PRIVATE),
+                JavaFieldProto::new("muted", "Z", FieldAccessFlags::PRIVATE),
+                JavaFieldProto::new("audioHandle", "I", FieldAccessFlags::PRIVATE),
+            ],
+            access_flags: ClassAccessFlags::PUBLIC,
+        }
+    }
+
+    async fn init(jvm: &Jvm, _: &mut WieJvmContext, mut this: ClassInstanceRef<Self>, audio_handle: i32) -> JvmResult<()> {
+        let _: () = jvm.invoke_special(&this, "java/lang/Object", "<init>", "()V", ()).await?;
+
+        jvm.put_field(&mut this, "net/wie/PlayerVolumeControl", "audioHandle", "I", audio_handle)
+            .await?;
+        jvm.put_field(&mut this, "net/wie/PlayerVolumeControl", "level", "I", MAX_AUDIO_VOLUME as i32)
+            .await
+    }
+
+    async fn set_mute(jvm: &Jvm, context: &mut WieJvmContext, mut this: ClassInstanceRef<Self>, muted: bool) -> JvmResult<()> {
+        tracing::debug!("net.wie.PlayerVolumeControl::setMute({this:?}, {muted})");
+
+        jvm.put_field(&mut this, "net/wie/PlayerVolumeControl", "muted", "Z", muted).await?;
+
+        Self::apply(jvm, context, &this).await
+    }
+
+    async fn apply(jvm: &Jvm, context: &mut WieJvmContext, this: &ClassInstanceRef<Self>) -> JvmResult<()> {
+        let audio_handle: i32 = jvm.get_field(this, "net/wie/PlayerVolumeControl", "audioHandle", "I").await?;
+        let level: i32 = jvm.get_field(this, "net/wie/PlayerVolumeControl", "level", "I").await?;
+        let muted: bool = jvm.get_field(this, "net/wie/PlayerVolumeControl", "muted", "Z").await?;
+
+        let volume = if muted { 0 } else { level as u8 };
+        // a closed player has no sound left to change
+        let _ = context.system().audio().set_volume(audio_handle as u32, volume);
+
+        Ok(())
+    }
+
+    async fn is_muted(jvm: &Jvm, _: &mut WieJvmContext, this: ClassInstanceRef<Self>) -> JvmResult<bool> {
+        jvm.get_field(&this, "net/wie/PlayerVolumeControl", "muted", "Z").await
+    }
+
+    /// Clamps to 0..=100 and returns the level that was set.
+    async fn set_level(jvm: &Jvm, context: &mut WieJvmContext, mut this: ClassInstanceRef<Self>, level: i32) -> JvmResult<i32> {
+        tracing::debug!("net.wie.PlayerVolumeControl::setLevel({this:?}, {level})");
+
+        let level = level.clamp(0, MAX_AUDIO_VOLUME as i32);
+        jvm.put_field(&mut this, "net/wie/PlayerVolumeControl", "level", "I", level).await?;
+        Self::apply(jvm, context, &this).await?;
+
+        Ok(level)
+    }
+
+    async fn get_level(jvm: &Jvm, _: &mut WieJvmContext, this: ClassInstanceRef<Self>) -> JvmResult<i32> {
+        jvm.get_field(&this, "net/wie/PlayerVolumeControl", "level", "I").await
+    }
+}
