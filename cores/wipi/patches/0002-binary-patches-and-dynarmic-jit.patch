+            let mut buf = [0u8; 4];
+            core.read_bytes(0x4000, &mut buf)?;
+            assert_eq!(&buf[0..2], &[0x11, 0x22], "patch applied");
+            assert_eq!(buf[3], 0xdf, "hook SVC high byte");
+            assert_eq!(buf[2] as u32, 0x80, "hook SVC low byte = SVC #0x80");
