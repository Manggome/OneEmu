diff --git a/wie-core-arm/src/engine/dynarmic.rs b/wie-core-arm/src/engine/dynarmic.rs
new file mode 100644
index 00000000..1118c83b
--- /dev/null
+++ b/wie-core-arm/src/engine/dynarmic.rs
@@ -0,0 +1,261 @@
+//! ARM32 JIT engine on dynarmic (native targets only, behind the `dynarmic` feature).
+//!
+//! Guest memory is kept in 64 KiB host pages that never move once mapped; dynarmic reaches them through a
+//! 4 KiB-granular page table, so loads and stores run in generated code without calling back. Translated
+//! code is dropped when the host writes into a page that has been translated, and on CP15 cache maintenance.
+
+use alloc::{boxed::Box, format, vec, vec::Vec};
+use core::ffi::c_void;
+
+use wie_arm_jit_types::{CompiledArtifact, PreparationFuture};
+use wie_util::{Result, WieError};
+
+use crate::engine::{ArmEngine, ArmRegister, EngineRunResult, EngineStopReason, MemoryPermission};
+
+const PAGE_SIZE: usize = 0x10000;
+const PAGE_MASK: u32 = (PAGE_SIZE - 1) as _;
+const JIT_PAGE_BITS: u32 = 12;
+const JIT_PAGES_PER_PAGE: usize = PAGE_SIZE >> JIT_PAGE_BITS;
+const CODE_CACHE_SIZE: usize = 32 * 1024 * 1024;
+
+const STOP_SVC: u32 = 1;
+const STOP_EXCEPTION: u32 = 2;
+const STOP_FAULT: u32 = 3;
+/// `Dynarmic::A32::Exception::NoExecuteFault`: a jump to an address without code.
+const EXCEPTION_NO_EXECUTE: u32 = 12;
+
+#[repr(C)]
+#[derive(Default)]
+struct WieDynStop {
+    kind: u32,
+    info: u32,
+    address: u32,
+    ticks_used: u64,
+}
+
+unsafe extern "C" {
+    fn wie_dyn_new(page_table: *mut *mut u8, code_pages: *mut u8, code_cache_size: usize) -> *mut c_void;
+    fn wie_dyn_free(handle: *mut c_void);
+    fn wie_dyn_run(handle: *mut c_void, ticks: u64, out: *mut WieDynStop);
+    fn wie_dyn_reg(handle: *mut c_void, index: u32) -> u32;
+    fn wie_dyn_set_reg(handle: *mut c_void, index: u32, value: u32);
+    fn wie_dyn_cpsr(handle: *mut c_void) -> u32;
+    fn wie_dyn_set_cpsr(handle: *mut c_void, value: u32);
+    fn wie_dyn_invalidate(handle: *mut c_void, address: u32, length: u32);
+}
+
+pub struct DynarmicEngine {
+    handle: *mut c_void,
+    pages: Vec<Option<Box<[u8; PAGE_SIZE]>>>,
+    // Both are read by generated code through raw pointers, so they must not move: boxed slices, never resized.
+    page_table: Box<[*mut u8]>,
+    code_pages: Box<[u8]>,
+}
+
+// The JIT and its tables are only ever touched through `&mut self` behind the core's mutex.
+unsafe impl Send for DynarmicEngine {}
+
+impl DynarmicEngine {
+    pub fn new() -> Self {
+        let mut page_table = vec![core::ptr::null_mut::<u8>(); 1 << (32 - JIT_PAGE_BITS)].into_boxed_slice();
+        let mut code_pages = vec![0u8; (1 << (32 - JIT_PAGE_BITS)) / 8].into_boxed_slice();
+        let handle = unsafe { wie_dyn_new(page_table.as_mut_ptr(), code_pages.as_mut_ptr(), CODE_CACHE_SIZE) };
+
+        Self {
+            handle,
+            pages: (0..0x10000).map(|_| None).collect(),
+            page_table,
+            code_pages,
+        }
+    }
+
+    fn page(&self, address: u32) -> Option<&[u8; PAGE_SIZE]> {
+        self.pages[(address >> 16) as usize].as_deref()
+    }
+
+    /// Drops translated code overlapping a host write, if any of it was ever translated.
+    fn invalidate_written(&mut self, address: u32, size: usize) {
+        if size == 0 {
+            return;
+        }
+        let first = address >> JIT_PAGE_BITS;
+        let last = address.wrapping_add(size as u32 - 1) >> JIT_PAGE_BITS;
+        let mut page = first;
+        loop {
+            if self.code_pages[(page >> 3) as usize] & (1 << (page & 7)) != 0 {
+                unsafe { wie_dyn_invalidate(self.handle, address, size as u32) };
+                return;
+            }
+            if page == last {
+                return;
+            }
+            page = page.wrapping_add(1);
+        }
+    }
+
+    fn register_index(reg: ArmRegister) -> u32 {
+        match reg {
+            ArmRegister::R0 => 0,
+            ArmRegister::R1 => 1,
+            ArmRegister::R2 => 2,
+            ArmRegister::R3 => 3,
+            ArmRegister::R4 => 4,
+            ArmRegister::R5 => 5,
+            ArmRegister::R6 => 6,
+            ArmRegister::R7 => 7,
+            ArmRegister::R8 => 8,
+            ArmRegister::SB => 9,
+            ArmRegister::SL => 10,
+            ArmRegister::FP => 11,
+            ArmRegister::IP => 12,
+            ArmRegister::SP => 13,
+            ArmRegister::LR => 14,
+            ArmRegister::PC => 15,
+            ArmRegister::Cpsr => unreachable!(),
+        }
+    }
+}
+
+impl Drop for DynarmicEngine {
+    fn drop(&mut self) {
+        unsafe { wie_dyn_free(self.handle) };
+    }
+}
+
+impl ArmEngine for DynarmicEngine {
+    fn run(&mut self, end: u32, count: u32) -> Result<EngineRunResult> {
+        let mut stop = WieDynStop::default();
+        unsafe { wie_dyn_run(self.handle, u64::from(count.max(1)), &mut stop) };
+        // Ticks are checked between blocks, so a run can overshoot the budget slightly.
+        let budget_consumed = (stop.ticks_used.min(u64::from(count))) as u32;
+
+        let stop_reason = match stop.kind {
+            STOP_SVC => {
+                // Same shape as the interpreter's SVC exception: LR = next instruction, SPSR = caller's CPSR.
+                let lr = unsafe { wie_dyn_reg(self.handle, 15) };
+                let spsr = unsafe { wie_dyn_cpsr(self.handle) };
+                EngineStopReason::Svc {
+                    category: stop.info,
+                    lr,
+                    spsr,
+                }
+            }
+            STOP_EXCEPTION if stop.info == EXCEPTION_NO_EXECUTE && stop.address == end => EngineStopReason::End,
+            STOP_EXCEPTION if stop.info == EXCEPTION_NO_EXECUTE => {
+                let lr = unsafe { wie_dyn_reg(self.handle, 14) };
+                tracing::error!("jump to unmapped pc {:#x} (lr {lr:#x})", stop.address);
+                return Err(WieError::InvalidMemoryAccess(stop.address));
+            }
+            STOP_EXCEPTION => {
+                let lr = unsafe { wie_dyn_reg(self.handle, 14) };
+                tracing::error!("cpu exception {} at pc {:#x} (lr {lr:#x})", stop.info, stop.address);
+                return Err(WieError::FatalError(format!("Undefined instruction at {:#x}", stop.address)));
+            }
+            STOP_FAULT => {
+                let pc = unsafe { wie_dyn_reg(self.handle, 15) };
+                let lr = unsafe { wie_dyn_reg(self.handle, 14) };
+                tracing::error!("memory fault accessing {:#x} at pc {pc:#x} (lr {lr:#x})", stop.address);
+                return Err(WieError::InvalidMemoryAccess(stop.address));
+            }
+            _ => EngineStopReason::Yield,
+        };
+
+        Ok(EngineRunResult {
+            stop_reason,
+            budget_consumed,
+        })
+    }
+
+    fn reg_write(&mut self, reg: ArmRegister, value: u32) {
+        match reg {
+            ArmRegister::Cpsr => unsafe { wie_dyn_set_cpsr(self.handle, value) },
+            ArmRegister::PC if value % 2 == 1 => unsafe {
+                wie_dyn_set_reg(self.handle, 15, value - 1);
+                wie_dyn_set_cpsr(self.handle, wie_dyn_cpsr(self.handle) | (1 << 5)); // T bit
+            },
+            _ => unsafe { wie_dyn_set_reg(self.handle, Self::register_index(reg), value) },
+        }
+    }
+
+    fn reg_read(&self, reg: ArmRegister) -> u32 {
+        match reg {
+            ArmRegister::Cpsr => unsafe { wie_dyn_cpsr(self.handle) },
+            _ => unsafe { wie_dyn_reg(self.handle, Self::register_index(reg)) },
+        }
+    }
+
+    fn mem_map(&mut self, address: u32, size: usize, _permission: MemoryPermission) {
+        let page_start = address & !PAGE_MASK;
+        let page_end = (u64::from(address) + size as u64 + u64::from(PAGE_MASK)) & !u64::from(PAGE_MASK);
+
+        for page in (u64::from(page_start)..page_end).step_by(PAGE_SIZE) {
+            let index = (page >> 16) as usize;
+            if self.pages[index].is_none() {
+                let mut bytes = Box::new([0u8; PAGE_SIZE]);
+                let base = bytes.as_mut_ptr();
+                for sub in 0..JIT_PAGES_PER_PAGE {
+                    self.page_table[index * JIT_PAGES_PER_PAGE + sub] = unsafe { base.add(sub << JIT_PAGE_BITS) };
+                }
+                self.pages[index] = Some(bytes);
+            }
+        }
+    }
+
+    fn mem_write(&mut self, address: u32, data: &[u8]) -> Result<()> {
+        let mut current = address;
+        let mut index = 0;
+        while index < data.len() {
+            let offset = (current & PAGE_MASK) as usize;
+            let bytes = self.pages[(current >> 16) as usize]
+                .as_deref_mut()
+                .ok_or(WieError::InvalidMemoryAccess(current))?;
+            let available = (PAGE_SIZE - offset).min(data.len() - index);
+            bytes[offset..offset + available].copy_from_slice(&data[index..index + available]);
+            index += available;
+            current = current.wrapping_add(available as u32);
+        }
+        self.invalidate_written(address, data.len());
+
+        Ok(())
+    }
+
+    fn mem_read(&mut self, address: u32, size: usize, result: &mut [u8]) -> Result<usize> {
+        let mut current = address;
+        let mut index = 0;
+        while index < size {
+            let offset = (current & PAGE_MASK) as usize;
+            let bytes = self.page(current).ok_or(WieError::InvalidMemoryAccess(current))?;
+            let available = (PAGE_SIZE - offset).min(size - index);
+            result[index..index + available].copy_from_slice(&bytes[offset..offset + available]);
+            index += available;
+            current = current.wrapping_add(available as u32);
+        }
+
+        Ok(size)
+    }
+
+    fn is_mapped(&self, address: u32, size: usize) -> bool {
+        let page_start = u64::from(address & !PAGE_MASK);
+        let page_end = (u64::from(address) + size as u64 + u64::from(PAGE_MASK)) & !u64::from(PAGE_MASK);
+
+        (page_start..page_end.max(page_start + 1))
+            .step_by(PAGE_SIZE)
+            .all(|page| self.pages[((page >> 16) & 0xffff) as usize].is_some())
+    }
+
+    fn record_image(&mut self, address: u32, size: usize) {
+        if size > 0 {
+            unsafe { wie_dyn_invalidate(self.handle, address, size as u32) };
+        }
+    }
+
+    fn begin_preparation(&mut self) -> Result<Option<PreparationFuture>> {
+        Ok(None)
+    }
+
+    fn is_preparing(&self) -> bool {
+        false
+    }
+
+    fn finish_preparation(&mut self, _result: Result<CompiledArtifact>) {}
+}
