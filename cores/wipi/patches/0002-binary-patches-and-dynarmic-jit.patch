diff --git a/wie-core-arm/build.rs b/wie-core-arm/build.rs
new file mode 100644
index 00000000..b6b2a70f
--- /dev/null
+++ b/wie-core-arm/build.rs
@@ -0,0 +1,39 @@
+fn main() {
+    #[cfg(feature = "dynarmic")]
+    dynarmic::build();
+}
+
+#[cfg(feature = "dynarmic")]
+mod dynarmic {
+    use std::{env, path::Path};
+
+    pub fn build() {
+        println!("cargo:rerun-if-changed=cpp/dynarmic_shim.cpp");
+        println!("cargo:rerun-if-env-changed=WIE_DYNARMIC_INCLUDE");
+        println!("cargo:rerun-if-env-changed=WIE_DYNARMIC_LIBS");
+
+        let include = env::var("WIE_DYNARMIC_INCLUDE").expect("WIE_DYNARMIC_INCLUDE: dynarmic's src directory");
+        let libs = env::var("WIE_DYNARMIC_LIBS").expect("WIE_DYNARMIC_LIBS: ';'-separated dynarmic static libraries");
+        let target = env::var("TARGET").unwrap();
+
+        let mut build = cc::Build::new();
+        build.cpp(true).std("c++20").include(&include).file("cpp/dynarmic_shim.cpp");
+        if target.contains("android") {
+            // Static libc++ keeps the core a single self-contained .so.
+            build.cpp_link_stdlib("c++_static");
+        }
+        build.compile("wie_dynarmic_shim");
+
+        for lib in libs.split(';').filter(|lib| !lib.is_empty()) {
+            let path = Path::new(lib);
+            println!("cargo:rustc-link-search=native={}", path.parent().unwrap().display());
+            let stem = path.file_stem().unwrap().to_str().unwrap();
+            let name = stem.strip_prefix("lib").filter(|_| !target.contains("msvc")).unwrap_or(stem);
+            println!("cargo:rustc-link-lib=static={name}");
+        }
+        if target.contains("android") {
+            // Resolved by the NDK linker from its sysroot at the final link, like cc's c++_static.
+            println!("cargo:rustc-link-lib=c++abi");
+        }
+    }
+}
diff --git a/wie-core-arm/cpp/dynarmic_shim.cpp b/wie-core-arm/cpp/dynarmic_shim.cpp
new file mode 100644
index 00000000..f47c1798
--- /dev/null
+++ b/wie-core-arm/cpp/dynarmic_shim.cpp
@@ -0,0 +1,285 @@
+// C ABI over dynarmic's A32 JIT for `engine::dynarmic`.
+//
+// Guest memory lives on the Rust side in 64 KiB pages; dynarmic sees it through its 4 KiB page table, so
+// aligned accesses never leave generated code. The callbacks below only run for unmapped addresses and for
+// accesses that straddle a 4 KiB page, and resolve those through the same table byte by byte.
+
+#include <array>
+#include <cstdint>
+#include <cstring>
+#include <memory>
+#include <optional>
+
+#include <dynarmic/interface/A32/a32.h>
+#include <dynarmic/interface/A32/config.h>
+#include <dynarmic/interface/A32/coprocessor.h>
+
+using namespace Dynarmic;
+
+namespace {
+
+using PageTable = std::array<std::uint8_t*, A32::UserConfig::NUM_PAGE_TABLE_ENTRIES>;
+constexpr std::uint32_t PAGE_BITS = A32::UserConfig::PAGE_BITS;
+constexpr std::uint32_t PAGE_MASK = (1u << PAGE_BITS) - 1;
+
+// Stop kinds reported to Rust.
+enum StopKind : std::uint32_t {
+    STOP_TICKS = 0,      // budget used up
+    STOP_SVC = 1,        // info = SVC immediate, R15 = next instruction
+    STOP_EXCEPTION = 2,  // info = exception, address = faulting pc
+    STOP_FAULT = 3,      // address = unmapped data address, R15 = faulting instruction
+};
+
+struct Shim;
+
+struct Callbacks final : A32::UserCallbacks {
+    Shim* shim = nullptr;
+
+    std::optional<std::uint32_t> MemoryReadCode(A32::VAddr vaddr) override;
+    std::uint8_t MemoryRead8(A32::VAddr vaddr) override { return Read<std::uint8_t>(vaddr); }
+    std::uint16_t MemoryRead16(A32::VAddr vaddr) override { return Read<std::uint16_t>(vaddr); }
+    std::uint32_t MemoryRead32(A32::VAddr vaddr) override { return Read<std::uint32_t>(vaddr); }
+    std::uint64_t MemoryRead64(A32::VAddr vaddr) override { return Read<std::uint64_t>(vaddr); }
+    void MemoryWrite8(A32::VAddr vaddr, std::uint8_t value) override { Write(vaddr, value); }
+    void MemoryWrite16(A32::VAddr vaddr, std::uint16_t value) override { Write(vaddr, value); }
+    void MemoryWrite32(A32::VAddr vaddr, std::uint32_t value) override { Write(vaddr, value); }
+    void MemoryWrite64(A32::VAddr vaddr, std::uint64_t value) override { Write(vaddr, value); }
+
+    void InterpreterFallback(A32::VAddr pc, size_t) override;
+    void CallSVC(std::uint32_t swi) override;
+    void ExceptionRaised(A32::VAddr pc, A32::Exception exception) override;
+    void AddTicks(std::uint64_t ticks) override;
+    std::uint64_t GetTicksRemaining() override;
+
+    template<typename T>
+    T Read(A32::VAddr vaddr);
+    template<typename T>
+    void Write(A32::VAddr vaddr, T value);
+};
+
+// Accepts every CP15 operation. Cache maintenance on c7 (I-cache / unified invalidate) drops translated code;
+// everything else (barriers, MMU, TLB) is a no-op for a user-mode guest, and reads return 0.
+struct Cp15 final : A32::Coprocessor {
+    Shim* shim = nullptr;
+    std::uint32_t sink = 0;
+    std::uint32_t zero = 0;
+    std::uint32_t sink2 = 0;
+    std::uint32_t zero2 = 0;
+
+    static std::uint64_t Nop(void*, std::uint32_t, std::uint32_t) { return 0; }
+    static std::uint64_t InvalidateAll(void* user, std::uint32_t, std::uint32_t);
+    static std::uint64_t InvalidateLine(void* user, std::uint32_t address, std::uint32_t);
+
+    std::optional<Callback> CompileInternalOperation(bool, unsigned, A32::CoprocReg, A32::CoprocReg, A32::CoprocReg, unsigned) override {
+        return Callback{&Nop, nullptr};
+    }
+    CallbackOrAccessOneWord CompileSendOneWord(bool two, unsigned, A32::CoprocReg crn, A32::CoprocReg crm, unsigned opc2) override {
+        if (!two && crn == A32::CoprocReg::C7) {
+            // ARM926EJ-S c7: c5 = I-cache, c7 = I+D; opc2 0 = all, 1 = by MVA, 2 = by set/way.
+            if (crm == A32::CoprocReg::C5 || crm == A32::CoprocReg::C7) {
+                if (opc2 == 1) return Callback{&InvalidateLine, shim};
+                if (opc2 == 0 || opc2 == 2) return Callback{&InvalidateAll, shim};
+            }
+            return Callback{&Nop, nullptr};
+        }
+        return &sink;
+    }
+    CallbackOrAccessTwoWords CompileSendTwoWords(bool, unsigned, A32::CoprocReg) override {
+        return std::array<std::uint32_t*, 2>{&sink, &sink2};
+    }
+    CallbackOrAccessOneWord CompileGetOneWord(bool, unsigned, A32::CoprocReg, A32::CoprocReg, unsigned) override { return &zero; }
+    CallbackOrAccessTwoWords CompileGetTwoWords(bool, unsigned, A32::CoprocReg) override {
+        return std::array<std::uint32_t*, 2>{&zero, &zero2};
+    }
+    std::optional<Callback> CompileLoadWords(bool, bool, A32::CoprocReg, std::optional<std::uint8_t>) override {
+        return Callback{&Nop, nullptr};
+    }
+    std::optional<Callback> CompileStoreWords(bool, bool, A32::CoprocReg, std::optional<std::uint8_t>) override {
+        return Callback{&Nop, nullptr};
+    }
+};
+
+struct Shim {
+    Callbacks callbacks;
+    PageTable* page_table;
+    // One bit per 4 KiB page that has been translated, so host writes know when to drop code.
+    std::uint8_t* code_pages;
+    std::unique_ptr<A32::Jit> jit;
+
+    std::uint64_t ticks_left = 0;
+    std::uint32_t stop_kind = STOP_TICKS;
+    std::uint32_t stop_info = 0;
+    std::uint32_t stop_address = 0;
+    bool stopped = false;
+
+    void Stop(StopKind kind, std::uint32_t info, std::uint32_t address, HaltReason reason) {
+        if (stopped) return;
+        stopped = true;
+        stop_kind = kind;
+        stop_info = info;
+        stop_address = address;
+        jit->HaltExecution(reason);
+    }
+};
+
+std::optional<std::uint32_t> Callbacks::MemoryReadCode(A32::VAddr vaddr) {
+    std::uint8_t* page = (*shim->page_table)[vaddr >> PAGE_BITS];
+    if (page == nullptr || vaddr < 0x1000) return std::nullopt;
+    shim->code_pages[vaddr >> (PAGE_BITS + 3)] |= std::uint8_t(1u << ((vaddr >> PAGE_BITS) & 7));
+    std::uint32_t value;
+    std::memcpy(&value, page + (vaddr & PAGE_MASK), sizeof(value));  // aligned: never straddles a page
+    return value;
+}
+
+template<typename T>
+T Callbacks::Read(A32::VAddr vaddr) {
+    T value = 0;
+    for (std::uint32_t i = 0; i < sizeof(T); ++i) {
+        const std::uint32_t address = vaddr + i;
+        std::uint8_t* page = (*shim->page_table)[address >> PAGE_BITS];
+        if (page == nullptr) {
+            shim->Stop(STOP_FAULT, 0, address, HaltReason::MemoryAbort);
+            return 0;
+        }
+        value |= T(page[address & PAGE_MASK]) << (8 * i);
+    }
+    return value;
+}
+
+template<typename T>
+void Callbacks::Write(A32::VAddr vaddr, T value) {
+    for (std::uint32_t i = 0; i < sizeof(T); ++i) {
+        const std::uint32_t address = vaddr + i;
+        std::uint8_t* page = (*shim->page_table)[address >> PAGE_BITS];
+        if (page == nullptr) {
+            shim->Stop(STOP_FAULT, 0, address, HaltReason::MemoryAbort);
+            return;
+        }
+        page[address & PAGE_MASK] = std::uint8_t(value >> (8 * i));
+    }
+}
+
+void Callbacks::InterpreterFallback(A32::VAddr pc, size_t) {
+    // Only privileged forms (CPS, RFE, SRS, user-bank LDM/STM) land here; a user-mode guest never uses them.
+    shim->Stop(STOP_EXCEPTION, 0xff, pc, HaltReason::UserDefined2);
+}
+
+void Callbacks::CallSVC(std::uint32_t swi) {
+    shim->Stop(STOP_SVC, swi, 0, HaltReason::UserDefined1);
+}
+
+void Callbacks::ExceptionRaised(A32::VAddr pc, A32::Exception exception) {
+    switch (exception) {
+    case A32::Exception::UndefinedInstruction:
+    case A32::Exception::UnpredictableInstruction:
+    case A32::Exception::DecodeError:
+    case A32::Exception::Breakpoint:
+    case A32::Exception::NoExecuteFault:
+        shim->jit->Regs()[15] = pc;
+        shim->Stop(STOP_EXCEPTION, static_cast<std::uint32_t>(exception), pc, HaltReason::UserDefined2);
+        break;
+    default:
+        // Hints (yield, wfi, pld, ...) have no effect in user mode.
+        break;
+    }
+}
+
+void Callbacks::AddTicks(std::uint64_t ticks) {
+    shim->ticks_left = ticks > shim->ticks_left ? 0 : shim->ticks_left - ticks;
+}
+
+std::uint64_t Callbacks::GetTicksRemaining() {
+    return shim->ticks_left;
+}
+
+std::uint64_t Cp15::InvalidateAll(void* user, std::uint32_t, std::uint32_t) {
+    static_cast<Shim*>(user)->jit->ClearCache();
+    return 0;
+}
+
+std::uint64_t Cp15::InvalidateLine(void* user, std::uint32_t address, std::uint32_t) {
+    // ARM926EJ-S cache lines are 32 bytes.
+    static_cast<Shim*>(user)->jit->InvalidateCacheRange(address & ~31u, 32);
+    return 0;
+}
+
+}  // namespace
+
+extern "C" {
+
+struct WieDynStop {
+    std::uint32_t kind;
+    std::uint32_t info;
+    std::uint32_t address;
+    std::uint64_t ticks_used;
+};
+
+void* wie_dyn_new(std::uint8_t** page_table, std::uint8_t* code_pages, std::size_t code_cache_size) {
+    auto* shim = new Shim{};
+    shim->callbacks.shim = shim;
+    shim->page_table = reinterpret_cast<PageTable*>(page_table);
+    shim->code_pages = code_pages;
+
+    A32::UserConfig config{};
+    config.callbacks = &shim->callbacks;
+    config.arch_version = A32::ArchVersion::v5TE;
+    config.page_table = shim->page_table;
+    config.absolute_offset_page_table = false;
+    // Accesses that straddle a 4 KiB page go to the callbacks: neighbouring guest pages need not be adjacent.
+    config.detect_misaligned_access_via_page_table = 16 | 32 | 64;
+    config.only_detect_misalignment_via_page_table_on_page_boundary = true;
+    config.check_halt_on_memory_access = true;
+    config.define_unpredictable_behaviour = true;
+    config.code_cache_size = code_cache_size;
+    for (std::size_t i = 0; i < config.coprocessors.size(); ++i) {
+        if (i == 10 || i == 11) continue;  // VFP is decoded by dynarmic itself
+        auto cp = std::make_shared<Cp15>();
+        cp->shim = shim;
+        config.coprocessors[i] = cp;
+    }
+    shim->jit = std::make_unique<A32::Jit>(config);
+    return shim;
+}
+
+void wie_dyn_free(void* handle) {
+    delete static_cast<Shim*>(handle);
+}
+
+void wie_dyn_run(void* handle, std::uint64_t ticks, WieDynStop* out) {
+    auto* shim = static_cast<Shim*>(handle);
+    shim->ticks_left = ticks;
+    shim->stopped = false;
+    for (;;) {
+        const HaltReason reason = shim->jit->Run();
+        if (shim->stopped || shim->ticks_left == 0) break;
+        // Halted only to flush invalidated code (CP15 / host write): keep going.
+        if (Has(reason, HaltReason::CacheInvalidation)) continue;
+        if (!Has(reason, HaltReason::UserDefined1) && !Has(reason, HaltReason::UserDefined2)) break;
+    }
+    out->kind = shim->stopped ? shim->stop_kind : STOP_TICKS;
+    out->info = shim->stop_info;
+    out->address = shim->stop_address;
+    out->ticks_used = ticks - shim->ticks_left;
+}
+
+std::uint32_t wie_dyn_reg(void* handle, std::uint32_t index) {
+    return static_cast<Shim*>(handle)->jit->Regs()[index];
+}
+
+void wie_dyn_set_reg(void* handle, std::uint32_t index, std::uint32_t value) {
+    static_cast<Shim*>(handle)->jit->Regs()[index] = value;
+}
+
+std::uint32_t wie_dyn_cpsr(void* handle) {
+    return static_cast<Shim*>(handle)->jit->Cpsr();
+}
+
+void wie_dyn_set_cpsr(void* handle, std::uint32_t value) {
+    static_cast<Shim*>(handle)->jit->SetCpsr(value);
+}
+
+void wie_dyn_invalidate(void* handle, std::uint32_t address, std::uint32_t length) {
+    static_cast<Shim*>(handle)->jit->InvalidateCacheRange(address, length);
+}
+
+}  // extern "C"
diff --git a/wie-core-arm/data/binary_patches.toml b/wie-core-arm/data/binary_patches.toml
new file mode 100644
index 00000000..ddd2fae2
--- /dev/null
+++ b/wie-core-arm/data/binary_patches.toml
@@ -0,0 +1,100 @@
+# Game-specific binary patches consumed by `wie_core_arm::install_binary_patches`.
+#
+# Each `[[entry]]` is either:
+#   - hash-keyed: `hash` is the MD5 of the main guest binary (KTF
+#     `client.bin`, LGT `binary.mod`, etc.). Matched and installed on boot.
+#   - pattern-only (hash omitted): generic patterns that apply to any binary
+#     matching the bytes. Hash-keyed entries take priority.
+#
+# Hook `pc`/`exit_pc` MUST have the Thumb bit (LSB=1); ARM-mode hooks are
+# not supported. Stack offsets are signed and measured from R7 (Thumb
+# frame pointer).
+#
+# A hook is either pc-based (`pc = ...`) or pattern-based (`pattern = ...`),
+# never both. Pattern tokens are whitespace-separated and each token is one of:
+#   - `??`        — any byte (unnamed wildcard)
+#   - `xx`        — literal hex byte
+#   - `{dst}`     — 1 byte, Thumb1 `SUBS Rn, #imm8` imm8 → `-(b as i8) as i32`
+#   - `{src}`     — same, src offset
+#   - `{len}`     — same, len offset (omit capture + provide `len_offset` to pin)
+#   - `{exit_b}`  — TWO consecutive tokens, encoding a Thumb `B imm11` instruction
+#
+# `inline_copy` fixed fields:
+#   - `len_offset`   — R7-relative offset of the length variable. Required if
+#                      the pattern has no `{len}` capture; forbidden if it does.
+#   - `spill_back`   — after the copy, also write back `dst += len`, `src += len`,
+#                      `len = 0` into their stack slots. Set true when the code
+#                      after the loop re-reads those variables.
+#
+# `inline_copy` requires the loop to use a DOWN-counter (length stored on the
+# stack and decremented to 0 to exit). UP-counter loops are NOT compatible —
+# zeroing the slot just resets the index and the loop restarts.
+#
+# In addition to hooks, an entry may contain `[[entry.patch]]` items that
+# rewrite raw bytes at install time (no SVC, no runtime dispatch). A patch is
+# either pc-based (`pc = 0x...`, requires the entry's `hash`) or pattern-based
+# (`pattern = "..."`, applied at every match).
+#   - `bytes`  : whitespace-separated hex literals. Length >= 1. May not
+#                contain the SVC #0x80 instruction (`80 df` LE).
+#   - `expect` : optional original bytes; same length as `bytes`. Strongly
+#                recommended — install fails fast on a build mismatch.
+#   - `offset` : pattern-only. Bytes are written at `match_addr + offset`.
+#                Default 0. Range `0 ..= pattern_len - bytes_len`.
+# Patch patterns may use `??`, hex literals, and `0b<bits>` BitMatch with no
+# register placeholders. They may NOT use `{dst}`/`{src}`/`{len}`/`{exit_b}`
+# captures or `s`/`d`/`c` BitMatch placeholders — patches have no captures to
+# consume.
+#
+# Install order: patches first, hooks second. Patch ↔ patch and patch ↔ hook
+# SVC overlap fails the install. A hash-keyed entry that produces zero
+# patches/hooks is fatal (likely a stale entry against an updated binary);
+# generic (hash-less) entries warn and continue.
+
+[[entry]]
+name = "Generic compiler library / inline copy patterns"
+
+# Per-frame byte-by-byte memcpy with `src/dst/count` in registers.
+# Loop:
+#   LDRB R3, [Rsrc];   STRB R3, [Rdst]
+#   MOV  R3, Rcount;   ADDS Rsrc, #1; ADDS Rdst, #1; SUBS Rcount, #1
+#   CMP  R3, #0;       BGT loop
+# `Rcount` holds `remaining - 1`, so actual byte count is `Rcount + 1`.
+# Seen as the dominant per-frame hot path in mgh2's `copy_offscreen_to_screen`.
+# Bit-pattern tokens use `s`/`d`/`c` to capture src/dst/count register fields;
+# `exit_pc` is auto-derived as `match_end | 1` (right past the BGT).
+[[entry.hook]]
+kind = "reg_inline_copy"
+pattern = "0b00sss011 78 0b00ddd011 70 0b00ccc011 1c 01 0b00110sss 01 0b00110ddd 01 0b00111ccc 00 2b f7 dc"
+count_offset = 1
+
+# Thumb -O0 byte copy: `*dst++ = *src++` with `dst`/`src`/`len` all on the
+# stack. Src is reached via single-instruction `SUBS R4, R7, #4` (`3c 1f`),
+# so `src_offset` is pinned.
+[[entry.hook]]
+kind = "inline_copy"
+pattern = "3d 1c {dst} 3d 29 68 3c 1f 22 68 08 1c 13 1c 1b 78 03 70 01 32 22 60 01 31 29 60 {exit_b} {exit_b}"
+src_offset = -4
+len_offset = -12
+spill_back = true
+
+# RVCT __rt_memcpy / __rt_memset reached through a Thumb `BX PC` thunk.
+# Prefix `BX PC; NOP; STMFD SP!, {R0, LR}; CMP R2, #N` is specific to the
+# standard library helpers; the trailing `CMP R2` immediate is what
+# distinguishes them (`#3` for memcpy, `#4` for memset).
+[[entry.hook]]
+kind = "memcpy"
+pattern = "78 47 00 00 01 40 2d e9 03 00 52 e3"
+
+[[entry.hook]]
+kind = "memset"
+pattern = "78 47 00 00 01 40 2d e9 04 00 52 e3"
+
+# RVCT Thumb strcpy / strlen with Mycroft's NUL-byte detection
+# (`0xFEFEFEFF`/`0x80808080` magic words).
+[[entry.hook]]
+kind = "strcpy"
+pattern = "70 b5 0b 1c 03 43 03 22 13 40 04 1c"
+
+[[entry.hook]]
+kind = "strlen"
+pattern = "30 b5 03 23 03 40 04 1c 00 2b"
diff --git a/wie-core-arm/src/binary_patches.rs b/wie-core-arm/src/binary_patches.rs
new file mode 100644
index 00000000..6945f423
--- /dev/null
+++ b/wie-core-arm/src/binary_patches.rs
@@ -0,0 +1,492 @@
+use alloc::{format, vec, vec::Vec};
+
+use wie_util::{ByteRead, Result, WieError};
+
+use crate::ArmCore;
+
+mod hook;
+mod parser;
+mod patch;
+
+use self::{
+    hook::{Hook, PatternHook},
+    patch::{PatchSpec, PatternPatchSpec},
+};
+
+/// Match the binary against the embedded patch table and install any matching
+/// patches/hooks. The on-disk MD5 selects a hash-keyed entry first, falling
+/// back to a hash-less generic entry. `scan_ranges` are the `(base, size)` byte
+/// ranges searched for pattern matching (typically the guest `.text` region).
+/// Returns the number of patches + hooks installed.
+pub fn install_binary_patches(core: &mut ArmCore, data: &[u8], scan_ranges: &[(u32, u32)]) -> Result<usize> {
+    let hash = md5::compute(data).0;
+    let entries = parser::binary_patches();
+    if let Some(entry) = entries.iter().find(|e| matches!(e.hash, Some(h) if h == hash)) {
+        return install_entry(core, entry, scan_ranges, true);
+    }
+    if let Some(entry) = entries.iter().find(|e| e.hash.is_none()) {
+        return install_entry(core, entry, scan_ranges, false);
+    }
+    Ok(0)
+}
+
+struct Entry {
+    hash: Option<[u8; 16]>,
+    name: alloc::string::String,
+    hooks: Vec<Hook>,
+    hook_patterns: Vec<PatternHook>,
+    patches: Vec<PatchSpec>,
+    patch_patterns: Vec<PatternPatchSpec>,
+}
+
+enum PatternToken {
+    Literal(u8),
+    AnyByte,
+    Capture(CaptureName),
+    /// Bit-level match for a byte that mixes a fixed opcode with a 3-bit
+    /// register field (Thumb1 low-register encoding). `(byte & mask) == fixed`
+    /// is the literal check; if `capture` is set, `(byte >> shift) & 0b111`
+    /// is read into the named register slot, with cross-byte consistency
+    /// enforced at match time.
+    BitMatch {
+        mask: u8,
+        fixed: u8,
+        capture: Option<(CaptureName, u8)>,
+    },
+}
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum CaptureName {
+    Dst,
+    Src,
+    Len,
+    ExitB,
+    SrcReg,
+    DstReg,
+    CountReg,
+}
+
+#[derive(Debug, Clone)]
+struct PatternMatch {
+    addr: u32,
+    dst: Option<u8>,
+    src: Option<u8>,
+    len: Option<u8>,
+    src_reg: Option<u8>,
+    dst_reg: Option<u8>,
+    count_reg: Option<u8>,
+    /// Address of the first `{exit_b}` byte — combined with `exit_b_bytes` to
+    /// compute the branch target.
+    exit_b_site: Option<u32>,
+    exit_b_bytes: Option<[u8; 2]>,
+}
+
+fn install_entry(core: &mut ArmCore, entry: &Entry, scan_ranges: &[(u32, u32)], is_specific: bool) -> Result<usize> {
+    let hooks = hook::resolve_hooks(core, entry, scan_ranges)?;
+    let n_patches = patch::install_patches(core, entry, scan_ranges, &hooks)?;
+
+    // A hash-keyed entry that produces zero installations is a strong signal
+    // that the binary drifted from what the patch table targets. Generic
+    // (hash-less) entries have no such guarantee. We trust the caller's
+    // `is_specific` rather than `entry.hash.is_some()` so that a placeholder
+    // all-zero hash in a fixture doesn't accidentally trigger this.
+    if n_patches == 0 && hooks.is_empty() {
+        if is_specific {
+            return Err(WieError::FatalError(format!(
+                "entry {}: hash matched but produced 0 patches/hooks (table likely out of date)",
+                entry.name
+            )));
+        }
+        tracing::warn!("entry {}: generic entry produced 0 patches/hooks", entry.name);
+    }
+
+    hook::apply_hooks(core, &entry.name, &hooks)?;
+    Ok(n_patches + hooks.len())
+}
+
+/// Scans on 2-byte boundaries since all Thumb instructions are halfword-aligned.
+fn scan_pattern(core: &mut ArmCore, tokens: &[PatternToken], scan_ranges: &[(u32, u32)]) -> Result<Vec<(u32, PatternMatch)>> {
+    let mut results = Vec::new();
+    let pat_len = tokens.len();
+    if pat_len == 0 {
+        return Ok(results);
+    }
+
+    for (base, size) in scan_ranges {
+        let mut buf = vec![0u8; *size as usize];
+        core.read_bytes(*base, &mut buf)?;
+
+        let mut off = 0usize;
+        while off + pat_len <= buf.len() {
+            if let Some(mut pm) = try_match(tokens, &buf[off..off + pat_len]) {
+                pm.addr = base + off as u32;
+                if pm.exit_b_bytes.is_some() {
+                    for (ti, t) in tokens.iter().enumerate() {
+                        if matches!(t, PatternToken::Capture(CaptureName::ExitB)) {
+                            pm.exit_b_site = Some(base + (off + ti) as u32);
+                            break;
+                        }
+                    }
+                }
+                results.push((pm.addr, pm));
+            }
+            off += 2;
+        }
+    }
+
+    Ok(results)
+}
+
+/// Returns a `PatternMatch` with captures populated; `addr` and `exit_b_site`
+/// are filled in by the caller from the actual scan position.
+fn try_match(tokens: &[PatternToken], bytes: &[u8]) -> Option<PatternMatch> {
+    if bytes.len() < tokens.len() {
+        return None;
+    }
+    let mut m = PatternMatch {
+        addr: 0,
+        dst: None,
+        src: None,
+        len: None,
+        src_reg: None,
+        dst_reg: None,
+        count_reg: None,
+        exit_b_site: None,
+        exit_b_bytes: None,
+    };
+    let mut i = 0;
+    while i < tokens.len() {
+        let b = bytes[i];
+        match &tokens[i] {
+            PatternToken::Literal(v) => {
+                if b != *v {
+                    return None;
+                }
+                i += 1;
+            }
+            PatternToken::AnyByte => {
+                i += 1;
+            }
+            PatternToken::BitMatch { mask, fixed, capture } => {
+                if b & mask != *fixed {
+                    return None;
+                }
+                if let Some((name, shift)) = capture {
+                    let value = (b >> shift) & 0b111;
+                    let slot = match name {
+                        CaptureName::SrcReg => &mut m.src_reg,
+                        CaptureName::DstReg => &mut m.dst_reg,
+                        CaptureName::CountReg => &mut m.count_reg,
+                        _ => return None,
+                    };
+                    if let Some(prev) = *slot
+                        && prev != value
+                    {
+                        return None;
+                    }
+                    *slot = Some(value);
+                }
+                i += 1;
+            }
+            PatternToken::Capture(name) => match name {
+                CaptureName::Dst => {
+                    m.dst = Some(b);
+                    i += 1;
+                }
+                CaptureName::Src => {
+                    m.src = Some(b);
+                    i += 1;
+                }
+                CaptureName::Len => {
+                    m.len = Some(b);
+                    i += 1;
+                }
+                CaptureName::ExitB => {
+                    if i + 1 >= bytes.len() || i + 1 >= tokens.len() {
+                        return None;
+                    }
+                    let hi = bytes[i + 1];
+                    if !matches!(tokens[i + 1], PatternToken::Capture(CaptureName::ExitB)) {
+                        return None;
+                    }
+                    // Reject matches where the captured bytes aren't a Thumb
+                    // unconditional `B imm11` (`11100 iiiiiiiiiii`, encoded as
+                    // 0xE0xx-0xE7xx little-endian). Without this, a permissive
+                    // pattern can land on arbitrary instructions and decode
+                    // them as if they were branches, sending the dispatcher
+                    // to a garbage `exit_pc`.
+                    if hi & 0xf8 != 0xe0 {
+                        return None;
+                    }
+                    m.exit_b_bytes = Some([b, hi]);
+                    i += 2;
+                }
+                CaptureName::SrcReg | CaptureName::DstReg | CaptureName::CountReg => {
+                    // Register captures only land in `BitMatch`, not whole-byte `Capture`.
+                    return None;
+                }
+            },
+        }
+    }
+    Some(m)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn embedded_toml_parses() {
+        let entries = parser::binary_patches();
+        assert!(!entries.is_empty(), "embedded TOML produced no entries");
+        for entry in &entries {
+            assert!(!entry.name.is_empty(), "entry missing name");
+        }
+    }
+
+    #[test]
+    fn pattern_scan_capture_extracts_dst_src() {
+        let tokens = [
+            PatternToken::Literal(0x00),
+            PatternToken::Capture(CaptureName::Dst),
+            PatternToken::Literal(0x3d),
+            PatternToken::Capture(CaptureName::Src),
+        ];
+        let bytes = [0x00, 0x08, 0x3d, 0x0c];
+
+        let m = try_match(&tokens, &bytes).expect("match");
+        assert_eq!(m.dst, Some(0x08));
+        assert_eq!(m.src, Some(0x0c));
+    }
+
+    #[test]
+    fn pattern_bit_match_captures_register_at_correct_shift() {
+        // `0b00sss011` matches `(src << 3) | 0b011`. Cross-byte consistency
+        // forces the same `s` capture to agree across positions.
+        let tokens = [
+            PatternToken::BitMatch {
+                mask: 0b1100_0111,
+                fixed: 0b0000_0011,
+                capture: Some((CaptureName::SrcReg, 3)),
+            },
+            PatternToken::BitMatch {
+                mask: 0b1111_1000,
+                fixed: 0b0011_0000,
+                capture: Some((CaptureName::SrcReg, 0)),
+            },
+        ];
+        // 0x0B = 0b00001011 → src bits 5..3 = 001 → R1
+        // 0x31 = 0b00110001 → src bits 2..0 = 001 → R1 (consistent)
+        let m = try_match(&tokens, &[0x0b, 0x31]).expect("match");
+        assert_eq!(m.src_reg, Some(1));
+
+        // Inconsistent capture must fail: first byte says R1, second says R2.
+        assert!(try_match(&tokens, &[0x0b, 0x32]).is_none());
+        // First byte's literal bits don't match (low nibble != 0b011).
+        assert!(try_match(&tokens, &[0x0a, 0x31]).is_none());
+    }
+
+    #[test]
+    fn pattern_scan_rejects_exit_b_capture_when_bytes_are_not_thumb_b() {
+        let tokens = [PatternToken::Capture(CaptureName::ExitB), PatternToken::Capture(CaptureName::ExitB)];
+        // `0c 3a` is `SUBS R2, #0xC` — high byte 0x3a is not in 0xE0-0xE7.
+        assert!(try_match(&tokens, &[0x0c, 0x3a]).is_none());
+        // `e8 e7` is a valid back-branch (high byte 0xE7).
+        assert!(try_match(&tokens, &[0xe8, 0xe7]).is_some());
+    }
+
+    mod install_entry_tests {
+        use alloc::{vec, vec::Vec};
+
+        use wie_util::ByteWrite;
