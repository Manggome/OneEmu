+/// Region transforms of MIDP 2.0 `Graphics.drawRegion` (the `Sprite.TRANS_*` values): an optional mirror
+/// about the region's vertical centre line, then a clockwise rotation.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum RegionTransform {
+    None = 0,
+    MirrorRot180 = 1,
+    Mirror = 2,
+    Rot180 = 3,
+    MirrorRot270 = 4,
+    Rot90 = 5,
+    Rot270 = 6,
+    MirrorRot90 = 7,
+}
+
+impl RegionTransform {
+    pub fn from_midp(value: i32) -> Option<Self> {
+        Some(match value {
+            0 => Self::None,
+            1 => Self::MirrorRot180,
+            2 => Self::Mirror,
+            3 => Self::Rot180,
+            4 => Self::MirrorRot270,
+            5 => Self::Rot90,
+            6 => Self::Rot270,
+            7 => Self::MirrorRot90,
+            _ => return None,
+        })
+    }
+
+    /// Size of a `width` x `height` region after the transform: quarter turns swap the axes.
+    pub fn transformed_size(self, width: u32, height: u32) -> (u32, u32) {
+        match self {
+            Self::MirrorRot270 | Self::Rot90 | Self::Rot270 | Self::MirrorRot90 => (height, width),
+            _ => (width, height),
+        }
+    }
+
+    /// The pixel of a `width` x `height` source region shown at (`u`, `v`) of the transformed region.
+    pub fn source_of(self, u: u32, v: u32, width: u32, height: u32) -> (u32, u32) {
+        let (right, bottom) = (width - 1, height - 1);
+        match self {
+            Self::None => (u, v),
+            Self::Mirror => (right - u, v),
+            Self::Rot180 => (right - u, bottom - v),
+            Self::MirrorRot180 => (u, bottom - v),
+            Self::Rot90 => (v, bottom - u),
+            Self::Rot270 => (right - v, u),
+            Self::MirrorRot90 => (right - v, bottom - u),
+            Self::MirrorRot270 => (v, u),
+        }
+    }
+}
+
+/// The part of the `width` x `height` region at (`sx`, `sy`) that lies inside `src`, with `transform`
+/// applied, and where that part sits inside the transformed region. `None` when the region misses `src`.
+pub fn transform_region(
+    src: &dyn Image,
+    sx: i32,
+    sy: i32,
+    width: u32,
+    height: u32,
+    transform: RegionTransform,
+) -> Option<(u32, u32, VecImageBuffer<ArgbPixel>)> {
+    let x0 = (sx as i64).max(0);
+    let y0 = (sy as i64).max(0);
+    let x1 = (sx as i64 + width as i64).min(src.width() as i64);
+    let y1 = (sy as i64 + height as i64).min(src.height() as i64);
+    if x0 >= x1 || y0 >= y1 {
+        return None;
+    }
+
+    let (part_width, part_height) = ((x1 - x0) as u32, (y1 - y0) as u32);
+    let mut part = vec![Color { a: 0, r: 0, g: 0, b: 0 }; part_width as usize * part_height as usize];
+    for (y, row) in part.chunks_exact_mut(part_width as usize).enumerate() {
+        src.get_pixels(x0 as i32, (y0 + y as i64) as i32, row);
+    }
+
+    let (out_width, out_height) = transform.transformed_size(part_width, part_height);
+    let mut data = Vec::with_capacity(part.len());
+    for v in 0..out_height {
+        for u in 0..out_width {
+            let (x, y) = transform.source_of(u, v, part_width, part_height);
+            data.push(ArgbPixel::from_color(part[(y * part_width + x) as usize]));
+        }
+    }
+
+    // margins of the part inside the region, then where the transform moves its top-left corner
+    let left = (x0 - sx as i64) as u32;
+    let top = (y0 - sy as i64) as u32;
+    let right = width - left - part_width;
+    let bottom = height - top - part_height;
+    let (u, v) = match transform {
+        RegionTransform::None => (left, top),
+        RegionTransform::Mirror => (right, top),
+        RegionTransform::Rot180 => (right, bottom),
+        RegionTransform::MirrorRot180 => (left, bottom),
+        RegionTransform::Rot90 => (bottom, left),
+        RegionTransform::Rot270 => (top, right),
+        RegionTransform::MirrorRot90 => (bottom, right),
+        RegionTransform::MirrorRot270 => (top, left),
+    };
+
+    Some((u, v, VecImageBuffer::from_raw(out_width, out_height, data)))
+}
