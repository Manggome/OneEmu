+
+    /// 3 x 2 image whose pixels are numbered 1..=6 in the red channel, row by row:
+    /// ```text
+    /// 1 2 3
+    /// 4 5 6
+    /// ```
+    fn numbered_3x2() -> VecImageBuffer<ArgbPixel> {
+        VecImageBuffer::from_raw(3, 2, (1..=6).map(|n| 0xff00_0000 | (n << 16)).collect())
+    }
+
+    fn numbers(image: &dyn Image) -> Vec<Vec<u8>> {
+        (0..image.height() as i32)
+            .map(|y| {
+                (0..image.width() as i32)
+                    .map(|x| {
+                        let color = image.get_pixel(x, y);
+                        if color.a == 0 { 0 } else { color.r }
+                    })
+                    .collect()
+            })
+            .collect()
+    }
+
+    /// Expected pictures from the MIDP 2.0 `Sprite` transform table (mirror first, then clockwise rotation).
+    const TRANSFORMED_3X2: [(RegionTransform, &[&[u8]]); 8] = [
+        (RegionTransform::None, &[&[1, 2, 3], &[4, 5, 6]]),
+        (RegionTransform::Mirror, &[&[3, 2, 1], &[6, 5, 4]]),
+        (RegionTransform::Rot180, &[&[6, 5, 4], &[3, 2, 1]]),
+        (RegionTransform::MirrorRot180, &[&[4, 5, 6], &[1, 2, 3]]),
+        (RegionTransform::Rot90, &[&[4, 1], &[5, 2], &[6, 3]]),
+        (RegionTransform::Rot270, &[&[3, 6], &[2, 5], &[1, 4]]),
+        (RegionTransform::MirrorRot90, &[&[6, 3], &[5, 2], &[4, 1]]),
+        (RegionTransform::MirrorRot270, &[&[1, 4], &[2, 5], &[3, 6]]),
+    ];
+
+    #[test]
+    fn transform_region_matches_midp_transforms() {
+        let src = numbered_3x2();
+        for (transform, expected) in TRANSFORMED_3X2 {
+            assert_eq!(RegionTransform::from_midp(transform as i32), Some(transform));
+            let (u, v, region) = transform_region(&src, 0, 0, 3, 2, transform).unwrap();
+            assert_eq!((u, v), (0, 0), "{transform:?}");
+            assert_eq!(numbers(&region), expected, "{transform:?}");
+        }
+        assert_eq!(RegionTransform::from_midp(8), None);
+        assert_eq!(RegionTransform::from_midp(-1), None);
+    }
+
+    #[test]
+    fn transform_region_of_a_sub_region() {
+        // the right 2 x 2 block of the 3 x 2 image: 2 3 / 5 6
+        let src = numbered_3x2();
+        let (_, _, region) = transform_region(&src, 1, 0, 2, 2, RegionTransform::Rot90).unwrap();
+        assert_eq!(numbers(&region), [[5, 2], [6, 3]]);
+        let (_, _, region) = transform_region(&src, 1, 0, 2, 2, RegionTransform::Mirror).unwrap();
+        assert_eq!(numbers(&region), [[3, 2], [6, 5]]);
+    }
+
+    #[test]
+    fn transform_region_places_the_part_inside_the_source() {
+        // a 5 x 4 region at (-1, -1) holds the 3 x 2 image with a 1 pixel margin left/top and 1 right, 2 bottom;
+        // transforming only the part inside the image must land where the whole padded region would put it
+        let src = numbered_3x2();
+        let mut padded = VecImageBuffer::<ArgbPixel>::new(5, 4);
+        for y in 0..2 {
+            for x in 0..3 {
+                padded.put_pixel(x + 1, y + 1, src.get_pixel(x, y));
+            }
+        }
+        for (transform, _) in TRANSFORMED_3X2 {
+            let (_, _, whole) = transform_region(&padded, 0, 0, 5, 4, transform).unwrap();
+            let (u, v, part) = transform_region(&src, -1, -1, 5, 4, transform).unwrap();
+
+            let mut placed = VecImageBuffer::<ArgbPixel>::new(whole.width(), whole.height());
+            for y in 0..part.height() as i32 {
+                for x in 0..part.width() as i32 {
+                    placed.put_pixel(x + u as i32, y + v as i32, part.get_pixel(x, y));
+                }
+            }
+            assert_eq!(numbers(&placed), numbers(&whole), "{transform:?}");
+        }
+    }
+
+    #[test]
+    fn transform_region_outside_the_source() {
+        let src = numbered_3x2();
+        assert!(transform_region(&src, 3, 0, 2, 2, RegionTransform::Rot90).is_none());
+        assert!(transform_region(&src, -2, 0, 2, 2, RegionTransform::Rot90).is_none());
+        assert!(transform_region(&src, 0, 0, 0, 2, RegionTransform::Rot90).is_none());
+    }
 }
