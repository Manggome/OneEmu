+# OneEmu: the libretro core, built from the same Android-vendored dependency set as the app's emucore.
+# The root CMakeLists cannot produce it here - it resolves PNG/JPEG/SDL3/Zstd/LZ4/WebP with desktop
+# find_package calls that have nothing to find in an NDK sysroot, which is exactly why this file exists.
+if(ARMSX2_BUILD_LIBRETRO)
+	# Host.h declares SetPadVibration (and the rest of the libretro-only Host surface) behind
+	# ENABLE_LIBRETRO. The root CMakeLists turns its ENABLE_LIBRETRO option into that define; this
+	# tree never includes it, so without this the core's own Main.cpp fails with "out-of-line
+	# definition ... does not match any declaration". PCSX2_FLAGS is the INTERFACE target both PCSX2
+	# and the core link, so the define reaches the call site inside PCSX2 as well.
+	target_compile_definitions(PCSX2_FLAGS INTERFACE ENABLE_LIBRETRO=1)
+	add_subdirectory("${ARMSX2_ROOT}/pcsx2-libretro" "${CMAKE_BINARY_DIR}/pcsx2-libretro")
+	target_link_libraries(pcsx2-libretro PRIVATE
+		common
+		imgui
+		libzip::zip
+		SDL3::SDL3
+		shaderc
+		vixl
+		adrenotools
+		Zstd::Zstd
+		android
+		log
+	)
+endif()
+
