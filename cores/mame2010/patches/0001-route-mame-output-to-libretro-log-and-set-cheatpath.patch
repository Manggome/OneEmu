+/* OneEmu: route MAME's own output channels (mame_printf_error/warning/info:
+ * romload "xxx NOT FOUND", "required files are missing", audit results...)
+ * to the libretro log instead of stderr, which is invisible on Android.
+ * One retro_log call per line so frontends keeping a per-line ring buffer do
+ * not truncate multi-line ROM reports. */
+static void retro_mame_output_cb(void *param, const char *format, va_list argptr)
+{
+   char buf[4096];
+   enum retro_log_level level = (enum retro_log_level)(intptr_t)param;
+   char *line = buf;
+
+   vsnprintf(buf, sizeof(buf), format, argptr);
+   if (retro_log == NULL)
+   {
+      fputs(buf, stderr);
+      return;
+   }
+   while (line != NULL && *line != '\0')
+   {
+      char *nl = strchr(line, '\n');
+      if (nl != NULL)
+         *nl = '\0';
+      if (*line != '\0')
+         retro_log(level, "[MAME 2010] %s\n", line);
+      line = (nl != NULL) ? nl + 1 : NULL;
+   }
+}
+
